+  });
+
+  it('a timeout after a possible send is AMBIGUOUS and NOT safeToRetry', async () => {
+    const { c } = client({
+      'mutation CreatePost': () => {
+        const err = new Error('socket hang up');
+        err.name = 'TimeoutError';
+        return Promise.reject(err);

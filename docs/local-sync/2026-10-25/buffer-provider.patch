+    });
+    const out = await c.create({ post: post('facebook') });
+    expect(out).toMatchObject({ outcome: PUBLISH_OUTCOME.AMBIGUOUS, safeToRetry: false });
+  });
+
+  it('a 429 that also carries a post id keeps the id (ACCEPTED), it is not "safe to retry"', () => {
+    const out = classifyCreateResponse({

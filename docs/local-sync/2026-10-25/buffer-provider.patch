+function freshState(over: Record<string, unknown> = {}) {
+  return {
+    schema_version: 1,
+    initialized_at: '2026-01-01T00:00:00.000Z',
+    revision: 0,
+    last_transition_nonce: null,
+    last_allocated_bluesky_micros: 0,
+    proven_deploys: {},
+    articles: {},
+    ...over,
+  };
+}

+import { ERROR_CLASS, HttpError, classifyStatus, requestJson } from '../http.js';
+
+/**
+ * Buffer GraphQL publishing adapter for the social publisher — Facebook Page, X
+ * and LinkedIn Page (plan social-distribution §1 / §3 / §6 / §10 / §12 / §13 /
+ * §15 / §17 / §18, package 7).
+ *
+ * > Provenance note. `SOCIAL_DISTRIBUTION_IMPLEMENTATION_PLAN.md` was briefly
+ * > lost from disk (it lived outside both repos and `/tmp` was cleared). A
+ * > byte-for-byte copy was recovered from the Claude Code session transcripts
+ * > and is kept alongside both repos at
+ * > `../SOCIAL_DISTRIBUTION_IMPLEMENTATION_PLAN.md` (the `noticiencias/` product
+ * > root). Section numbers below refer to it.
+ *
+ * ### What this adapter is
+ *
+ * It receives **frozen** content (`SocialPost` from `content.js`, §12) plus a
+ * validated destination and performs the Buffer GraphQL calls. It does NOT:
+ * - decide editorial eligibility (`article.js` / the orchestrator do that),
+ * - regenerate or re-truncate the copy (`content.js` already did, once),
+ * - persist ledger state (`state.js` owns `state.json`; this module returns
+ *   structured results the orchestrator feeds to `recordResult` /
+ *   `recordReconciliation` — see {@link toRecordResult}, {@link pollToRecordResult}
+ *   and {@link reconciliationParams}),
+ * - own polling cadence or the global API budget (that is the package-8
+ *   orchestrator's job — this module exposes single reads and bounded batches).
+ *
+ * ### Boundaries — and the one guarantee this adapter deliberately does NOT copy
+ *
+ * The Bluesky adapter can return `safeToRetry: true` on an HTTP 429 because its
+ * `putRecord` freezes an `rkey` up front and reconciles by that exact key, so a
+ * "429" that actually hid a completed write is caught structurally. **Buffer has
+ * no idempotency key for `createPost`** (§1 / §6 / §13: "No se encontraron
+ * idempotency key/client ID en `CreatePostInput`"). So:
+ *
+ * - A `create` executes **at most one** HTTP request. No transparent retry lives
+ *   in transport, auth or a helper. `../http.js` performs no retries and, with
+ *   `followRedirects: false`, makes exactly one `fetch` call (a 3xx makes it
+ *   throw *after* the bytes went out — which classifies AMBIGUOUS, never
+ *   "rejected without effect").
+ * - After a possible send, the default classification is **AMBIGUOUS** unless
+ *   there is affirmative evidence the request was rejected with no side effect
+ *   (§6 / §17). `safeToRetry: true` is emitted ONLY for a rate-limit signal that
+ *   also carries no post id anywhere in the response — the request never reached
+ *   a create handler.
+ * - A timeout / 5xx / unknown GraphQL error with no recoverable id does **not**
+ *   authorise another `create`. The pair goes AMBIGUOUS and is resolved by a
+ *   read: {@link createBufferClient} `get` (a known id) or `reconcile` (list the
+ *   channel and match the frozen copy). Zero matches is **not** proof of
+ *   absence; truncated pagination is **not** proof of uniqueness (§5 / §13).
+ * - There is no login/session step. Nothing `ensureSession`-shaped precedes a
+ *   call — the Bearer key is sent on each request and a 401 stops the run.
+ *
+ * ### Sources consulted — 2026-09-07
+ *
+ * The plan's §13 and §29 were compiled from a careful read on 2026-09-05; this
+ * package re-checked the Buffer developer docs on 2026-09-07. Those re-checks
+ * were read through a summarising fetch, not raw HTML, so where a field is not
+ * doc-confirmed it is either taken from the plan (a reviewed authority inside
+ * this repo) or made configuration-supplied and validated at runtime rather than
+ * shipped as a guess.
+ *
+ * | Fact | Provenance |
+ * |---|---|
+ * | Endpoint `https://api.buffer.com`, `POST`, `Authorization: Bearer`, `{ query, variables }` body | doc-confirmed (getting-started) + plan §13 |
+ * | GraphQL always HTTP 200; typed union errors in `data`, non-recoverable errors in top-level `errors[]` with `extensions.code` (`RATE_LIMIT_EXCEEDED`, `UNAUTHORIZED`, `FORBIDDEN`, `NOT_FOUND`, `UNEXPECTED`); HTTP 401/429 also occur | doc-confirmed (error-handling, api-limits) + plan §13 |
+ * | `CreatePostInput` required: `channelId`, `mode`, `schedulingType`, `needsApproval`, `assets`; optional `text`, `saveToDraft` | doc-confirmed (reference) |
+ * | `ShareMode` includes `shareNow`; `SchedulingType` `automatic` | doc-confirmed (reference) + plan §3 (the narrative guide omits `shareNow`; the enum has it — use the enum) |
+ * | `assets: [{ link: { url: <canonical> } }]` for a link post, `[]` for X | plan §10 authority (`AssetInput` shape not quoted verbatim in the fetched docs) |
+ * | createPost union: `... on PostActionSuccess { post { id status channelId text externalLink sentAt } }`, `... on MutationError { message }` | doc-confirmed (error-handling: "Always include `... on MutationError { message }`") + plan §13 |
+ * | `PostStatus` values `draft` / `error` / `needs_approval` / `scheduled` / `sending` / `sent` | plan §13 authority (fetched pages showed only `scheduled` / `sent` / `error`; §3 pre-flags the stale `buffer` label). Encoded as a decision table with a safe default so an unlisted value still cannot trigger a create. |
+ * | Rate-limit headers `RateLimit` / `RateLimit-Policy` / `Retry-After`; HTTP 429 | doc-confirmed (api-limits) |
+ * | `posts(first, after, input: { organizationId, filter: { channelIds } })` → `{ edges { node }, pageInfo { hasNextPage endCursor } }`; do NOT restrict `status` | plan §13 authority + doc-confirmed shape (get-posts-for-channels) |
+ * | `account { organizations { id name } }`, then `channels(input: { organizationId }) { id name service type }`; X service is `twitter` | doc-confirmed field names (reference, get-organizations, get-channels) + plan §13 (`twitter`). `ChannelType` enum values are NOT doc-confirmed → the expected `type` (and `service`) per platform is configuration-supplied and validated observed-equals-configured. |
+ * | Free plan: 100 req / 15 min, 250 / 24 h, 3 000 / 30 days; 3 channels; 10 pending posts / channel | doc-confirmed (api-limits, pricing) + plan §13. Budget/cadence belong to the orchestrator, not here. |
+ */
+
+// --- constants -------------------------------------------------------
+
+/** The Buffer platforms this adapter drives (Bluesky is a separate adapter). */
+export const BUFFER_PLATFORMS = Object.freeze(['facebook', 'x', 'linkedin']);
+
+/** Single GraphQL endpoint (doc-confirmed: getting-started / plan §13). */
+export const BUFFER_API_URL = 'https://api.buffer.com';
+export const BUFFER_API_HOST = 'api.buffer.com';
+
+/**
+ * Default `service` expected per platform — doc-backed: §13 states X's service
+ * is `twitter`; Facebook and LinkedIn are self-naming. `inspectChannels`
+ * validates the *observed* service equals this (or a caller override), so a
+ * profile can never be substituted for a Page's service (§13 / task §2).
+ *
+ * There is deliberately NO default `type`: `ChannelType` enum literals are not
+ * doc-confirmed, so `type` is validated ONLY when the caller supplies it
+ * explicitly. A phase-0 doctor run reads the real literal back from
+ * `DiscoveryResult.channels[platform].type` and pins it in config (§22 phase 0).
+ */
+export const DEFAULT_CHANNEL_SERVICE = Object.freeze({
+  facebook: 'facebook',
+  x: 'twitter',
+  linkedin: 'linkedin',
+});
+
+/** Reconciliation pagination ceiling per run (plan §13: "máximo diez páginas"). */
+export const MAX_RECONCILE_PAGES = 10;
+/** Page size for the reconciliation list (plan §13 example: `first: 100`). */
+export const RECONCILE_PAGE_SIZE = 100;
+/** Aliased `post` reads per batched request (plan §13: "máximo 10 por request"). */
+export const MAX_BATCH_GET = 10;
+
+const DEFAULT_READ_TIMEOUT_MS = 15_000;
+const DEFAULT_WRITE_TIMEOUT_MS = 30_000;
+/** Fallback wait applied to a RETRYABLE result when no `Retry-After` is present. */
+const DEFAULT_RETRY_DELAY_MS = 15 * 60_000;
+
+const ORG_ID_RE = /^[A-Za-z0-9:_-]{1,128}$/;
+const CHANNEL_ID_RE = /^[A-Za-z0-9:_-]{1,128}$/;
+const POST_ID_RE = /^[A-Za-z0-9:_-]{1,128}$/;
+
+/**
+ * What a Buffer `PostStatus` means for the ledger. `sent` is the ONLY value that
+ * confirms publication (task §3); `error` is an operational failure that keeps
+ * its id and is never re-created (§13); `draft` / `needs_approval` are
+ * unexpected MVP configuration and stop that channel (§13); everything
+ * else — including a value not in this table — keeps the id and follows up,
+ * never a create.
+ *
+ * @type {Readonly<Record<string, 'published'|'failed'|'channel-misconfigured'|'pending'>>}
+ */
+export const POST_STATUS_ACTION = Object.freeze({
+  sent: 'published',
+  error: 'failed',
+  draft: 'channel-misconfigured',
+  needs_approval: 'channel-misconfigured',
+  scheduled: 'pending',
+  sending: 'pending',
+});
+
+/** Resolve a `PostStatus` to its ledger action; an unknown value follows up. */
+export function postStatusAction(status) {
+  return POST_STATUS_ACTION[String(status)] ?? 'pending';
+}
+
+/**
+ * The outcomes a `create` can produce — the discriminant of a
+ * {@link PublishResult}. Exported so the mapping can be asserted, not
+ * re-derived from prose.
+ *
+ * - `accepted`        — Buffer returned a post id but not `sent`. The id is
+ *   recorded before any polling; a later `sent` promotes it to PUBLISHED. An
+ *   `unexpected-status` warning rides along for `draft` / `needs_approval`.
+ * - `confirmed`       — the returned post is already `status: sent`. Buffer id +
+ *   `externalLink` are returned.
+ * - `failed-with-id`  — the returned post is `status: error`. Keep the id; do
+ *   NOT create another object; a human repairs *that* object in Buffer (§13 /
+ *   §17).
+ * - `rejected`        — a recognised, no-effect content rejection
+ *   (`InvalidInputError`). Permanent for this payload until the copy/config is
+ *   fixed.
+ * - `channel-blocked` — a recognised channel-level rejection with no effect
+ *   (queue full / disconnected / permission). Stop this channel; a human acts.
+ * - `rate-limited`    — a rate-limit signal (HTTP 429 or top-level
+ *   `RATE_LIMIT_EXCEEDED`) with NO post id anywhere in the response. The request
+ *   never reached a create handler → provably no effect.
+ * - `auth-invalid`    — HTTP 401/403 or `UNAUTHORIZED` / `FORBIDDEN`. A
+ *   misconfiguration or a revoked key: every send this run fails the same way.
+ * - `ambiguous`       — everything else after a possible send (timeout, 5xx,
+ *   non-JSON body, a 2xx without a usable id, an unknown GraphQL error). Cannot
+ *   be proven rejected-without-effect → reconcile, never re-create.
+ */
+export const PUBLISH_OUTCOME = Object.freeze({
+  ACCEPTED: 'accepted',
+  CONFIRMED: 'confirmed',
+  FAILED_WITH_ID: 'failed-with-id',
+  REJECTED: 'rejected',
+  CHANNEL_BLOCKED: 'channel-blocked',
+  RATE_LIMITED: 'rate-limited',
+  AUTH_INVALID: 'auth-invalid',
+  AMBIGUOUS: 'ambiguous',
+});
+
+/** Structured decisions from {@link createBufferClient} `reconcile`. */
+export const RECONCILE_DECISION = Object.freeze({
+  /** Exactly one match and that post is `sent` → adopt as PUBLISHED. */
+  CONFIRMED: 'confirmed',
+  /** Exactly one match, not yet `sent` → adopt as ACCEPTED (with its id). */
+  ADOPT_ACCEPTED: 'adopt-accepted',
+  /** Multiple matches, a foreign channel, or a different post at a known id. */
+  CONFLICT: 'conflict',
+  /** Zero matches, truncated pagination, a partial/failed read — no claim. */
+  UNCERTAIN: 'uncertain',
+});
+
+/** Structured outcomes from {@link createBufferClient} `inspectChannels`. */
+export const DISCOVERY_OUTCOME = Object.freeze({
+  OK: 'ok',
+  READ_FAILED: 'read-failed',
+  ORG_NOT_FOUND: 'org-not-found',
+  CHANNEL_NOT_IN_ORG: 'channel-not-in-org',
+  SERVICE_MISMATCH: 'service-mismatch',
+  TYPE_MISMATCH: 'type-mismatch',
+});
+
+/** `get` / single-post read states. */
+export const READ_STATE = Object.freeze({
+  PRESENT: 'present',
+  ABSENT: 'absent',
+  UNKNOWN: 'unknown',
+});
+
+// --- GraphQL documents (frozen module constants, variables only) ----
+
+/**
+ * Every operation is a constant document with `$variables` — content is NEVER
+ * interpolated into the query string (§10 / §21: a future dry-run transport
+ * accepts only "documentos de consulta constantes aprobados"). These are
+ * exported for that allowlist.
+ */
+export const GQL = Object.freeze({
+  ACCOUNT_ORGANIZATIONS: `query AccountOrganizations {
+  account { id organizations { id name } }
+}`,
+
+  CHANNELS: `query Channels($organizationId: OrganizationId!) {
+  channels(input: { organizationId: $organizationId }) {
+    id
+    name
+    service
+    type
+  }
+}`,
+
+  CREATE_POST: `mutation CreatePost(
+  $channelId: ChannelId!
+  $text: String
+  $mode: ShareMode!
+  $schedulingType: SchedulingType!
+  $needsApproval: Boolean!
+  $saveToDraft: Boolean
+  $assets: [AssetInput!]!
+) {
+  createPost(input: {
+    channelId: $channelId
+    text: $text
+    mode: $mode
+    schedulingType: $schedulingType
+    needsApproval: $needsApproval
+    saveToDraft: $saveToDraft
+    assets: $assets
+  }) {
+    __typename
+    ... on PostActionSuccess {
+      post { id status channelId text externalLink sentAt }
+    }
+    ... on MutationError { message }
+  }
+}`,
+
+  POST_BY_ID: `query PostById($id: PostId!) {
+  post(input: { id: $id }) {
+    id
+    status
+    channelId
+    text
+    externalLink
+    sentAt
+  }
+}`,
+
+  POSTS_BY_CHANNEL: `query PostsByChannel(
+  $organizationId: OrganizationId!
+  $channelId: ChannelId!
+  $first: Int!
+  $after: String
+) {
+  posts(
+    first: $first
+    after: $after
+    input: { organizationId: $organizationId, filter: { channelIds: [$channelId] } }
+  ) {
+    edges {
+      node { id status channelId text externalLink sentAt createdAt }
+    }
+    pageInfo { hasNextPage endCursor }
+  }
+}`,
+});
+
+/**
+ * Build a batched aliased `post` document for up to {@link MAX_BATCH_GET} ids.
+ * Only aliases and variable *names* are generated — both are fixed identifiers,
+ * never caller data — and each id is still passed as a `$pN` variable.
+ * @param {number} count
+ * @returns {string}
+ */
+export function batchPostsDocument(count) {
+  const n = Math.min(Math.max(1, Math.trunc(count)), MAX_BATCH_GET);
+  const params = Array.from({ length: n }, (_, i) => `$p${i}: PostId!`).join(', ');
+  const selections = Array.from(
+    { length: n },
+    (_, i) =>
+      `  a${i}: post(input: { id: $p${i} }) { id status channelId text externalLink sentAt }`
+  ).join('\n');
+  return `query PostsByIds(${params}) {\n${selections}\n}`;
+}
+
+// --- errors ---------------------------------------------------------
+
+/**
+ * A programming-level failure (bad input, impossible config). Expected
+ * operational outcomes are returned as a {@link PublishResult} / structured
+ * object, not thrown. `message` is already redacted by the transport when it
+ * wraps an HTTP failure.
+ */
+export class BufferError extends Error {
+  /**
+   * @param {string} code stable — `CONFIG` for caller mistakes, otherwise a
+   *   {@link PUBLISH_OUTCOME} / {@link DISCOVERY_OUTCOME} value
+   * @param {string} message already sanitized
+   * @param {Record<string, unknown>} [detail]
+   */
+  constructor(code, message, detail = {}) {
+    super(message);
+    this.name = 'BufferError';
+    this.code = code;
+    this.detail = detail;
+  }
+}
+
+// --- small helpers ------------------------------------------------
+
+function isPlainObject(value) {
+  return value != null && typeof value === 'object' && !Array.isArray(value);
+}
+
+function isNonEmptyString(value) {
+  return typeof value === 'string' && value.trim() !== '';
+}
+
+/** Deterministic JSON (keys sorted). Used for evidence clipping, never a hash. */
+export function canonicalJson(value) {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value) ?? 'null';
+  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(',')}]`;
+  const keys = Object.keys(value).sort();
+  return `{${keys.map((k) => `${JSON.stringify(k)}:${canonicalJson(value[k])}`).join(',')}}`;
+}
+
+/** Clip an arbitrary value to a bounded JSON string for evidence payloads. */
+function clip(value, max = 600) {
+  const text = canonicalJson(value);
+  return text.length > max ? `${text.slice(0, max)}…` : text;
+}
+
+/**
+ * Whole-URL equality after normalization. NEVER a substring test: the
+ * reconciliation "URLs parecidas" case exists because `…/a/` is a prefix of
+ * `…/a/b/` — an `includes()` on either side would wrongly match (§5 / task §5).
+ * @param {unknown} a
+ * @param {unknown} b
+ * @returns {boolean}
+ */
+export function sameCanonical(a, b) {
+  if (!isNonEmptyString(a) || !isNonEmptyString(b)) return false;
+  let ua;
+  let ub;
+  try {
+    ua = new URL(String(a));
+    ub = new URL(String(b));
+  } catch {
+    return false;
+  }
+  return ua.href === ub.href;
+}
+
+/** Top-level GraphQL `errors[]`, normalized to `[{ message, code }]`. */
+function topLevelErrors(json) {
+  if (!isPlainObject(json) || !Array.isArray(json.errors)) return [];
+  return json.errors.filter(isPlainObject).map((e) => ({
+    message: isNonEmptyString(e.message) ? String(e.message) : '',
+    code:
+      isPlainObject(e.extensions) && isNonEmptyString(e.extensions.code)
+        ? String(e.extensions.code)
+        : null,
+  }));
+}
+
+function firstErrorCode(errors) {
+  for (const e of errors) if (e.code) return e.code;
+  return null;
+}
+
+/** A `post` object echoed by Buffer, normalized to the fields we consume. */
+function normalizePost(raw) {
+  if (!isPlainObject(raw) || !isNonEmptyString(raw.id)) return null;
+  return {
+    id: String(raw.id),
+    status: isNonEmptyString(raw.status) ? String(raw.status) : null,
+    channelId: isNonEmptyString(raw.channelId) ? String(raw.channelId) : null,
+    text: typeof raw.text === 'string' ? raw.text : null,
+    externalLink: isNonEmptyString(raw.externalLink) ? String(raw.externalLink) : null,
+    sentAt: isNonEmptyString(raw.sentAt) ? String(raw.sentAt) : null,
+    createdAt: isNonEmptyString(raw.createdAt) ? String(raw.createdAt) : null,
+  };
+}
+
+/**
+ * Dig a post object out of a `data.createPost` union payload.
+ * @returns {{ typename: string|null, post: object|null, message: string|null }}
+ */
+function readCreatePayload(json) {
+  const node = isPlainObject(json) && isPlainObject(json.data) ? json.data.createPost : null;
+  if (!isPlainObject(node)) return { typename: null, post: null, message: null };
+  const typename = isNonEmptyString(node.__typename) ? String(node.__typename) : null;
+  const post = normalizePost(node.post);
+  const message = isNonEmptyString(node.message) ? String(node.message) : null;
+  return { typename, post, message };
+}
+
+// --- create classification (pure) ------------------------------
+
+/**
+ * @typedef {object} PublishResult
+ * @property {string} outcome one of {@link PUBLISH_OUTCOME}
+ * @property {string} [providerId] the Buffer post id, whenever one is recoverable
+ * @property {string} [externalUrl] Buffer's `externalLink`
+ * @property {string|null} [providerStatus] the raw `PostStatus` when known
+ * @property {string|null} [errorClass] transport {@link ERROR_CLASS} for a transport failure
+ * @property {string|null} [errorCode] the GraphQL error code / `__typename`
+ * @property {number|null} [retryAfterMs] parsed `Retry-After` (on `rate-limited`)
+ * @property {boolean} [safeToRetry] `true` ONLY for a rate-limit signal with no post id
+ * @property {string|null} [warning] a stable channel-level warning code
+ * @property {Record<string, unknown>} evidence structured, non-secret facts
+ */
+
+/**
+ * Classify a completed `createPost` HTTP response (any status) into a
+ * {@link PublishResult}. Pure: every input is an argument.
+ *
+ * @param {{
+ *   httpStatus: number,
+ *   headers: Record<string, string>,
+ *   json: unknown,
+ *   retryAfterMs: number|null,
+ *   expectedChannelId: string,
+ * }} input
+ * @returns {PublishResult}
+ */
+export function classifyCreateResponse({
+  httpStatus,
+  headers = {},
+  json,
+  retryAfterMs = null,
+  expectedChannelId,
+}) {
+  const cls = classifyStatus(Number(httpStatus) || 0, headers);
+  const errors = topLevelErrors(json);
+  const errorCode = firstErrorCode(errors);
+  const { typename, post, message } = readCreatePayload(json);
+
+  const rateSignal = cls === ERROR_CLASS.RATE_LIMITED || errorCode === 'RATE_LIMIT_EXCEEDED';
+  const authSignal =
+    cls === ERROR_CLASS.AUTH || errorCode === 'UNAUTHORIZED' || errorCode === 'FORBIDDEN';
+
+  // Auth first: it dominates everything and stops the run. A 401/403 that also
+  // carries a post id (a contradictory response) still halts, but the id rides
+  // along so the orchestrator can persist ACCEPTED before halting and reconcile
+  // it after the key is rotated.
+  if (authSignal) {
+    return {
+      outcome: PUBLISH_OUTCOME.AUTH_INVALID,
+      ...(post ? { providerId: post.id, providerStatus: post.status } : {}),
+      errorClass: cls === ERROR_CLASS.AUTH ? cls : null,
+      errorCode,
+      evidence: {
+        phase: 'create',
+        httpStatus,
+        errorCode,
+        errors: errors.map((e) => e.message),
+        ...(post ? { recoverable_id: post.id } : {}),
+      },
+    };
+  }
+
+  // A recoverable post id always wins over a co-occurring error: keep the id,
+  // never confirm on an incomplete response (§6). A `sent` status alongside
+  // top-level errors is still only ACCEPTED — a later poll confirms it.
+  if (post) {
+    if (post.channelId && expectedChannelId && post.channelId !== expectedChannelId) {
+      return {
+        outcome: PUBLISH_OUTCOME.AMBIGUOUS,
+        providerId: post.id,
+        providerStatus: post.status,
+        evidence: {
+          phase: 'create',
+          reason: 'created post is for a different channel',
+          expected: expectedChannelId,
+          got: post.channelId,
+        },
+      };
+    }
+    const action = postStatusAction(post.status);
+    const base = {
+      providerId: post.id,
+      providerStatus: post.status,
+      ...(post.externalLink ? { externalUrl: post.externalLink } : {}),
+      evidence: {
+        phase: 'create',
+        httpStatus,
+        status: post.status,
+        ...(errors.length > 0 ? { coOccurringErrors: errors.map((e) => e.message) } : {}),
+      },
+    };
+    if (errors.length > 0 || cls !== ERROR_CLASS.OK) {
+      // Partial response: an id but also an error / non-2xx. Retain the id,
+      // classify AMBIGUOUS-with-id via ACCEPTED so it is polled, not re-created.
+      return { outcome: PUBLISH_OUTCOME.ACCEPTED, ...base };
+    }
+    if (action === 'published') return { outcome: PUBLISH_OUTCOME.CONFIRMED, ...base };
+    if (action === 'failed') return { outcome: PUBLISH_OUTCOME.FAILED_WITH_ID, ...base };
+    if (action === 'channel-misconfigured') {
+      return {
+        outcome: PUBLISH_OUTCOME.ACCEPTED,
+        ...base,
+        warning: `unexpected-status:${post.status}`,
+      };
+    }
+    return { outcome: PUBLISH_OUTCOME.ACCEPTED, ...base };
+  }
+
+  // No post id anywhere. A rate-limit signal here is provably no-effect: the
+  // request never reached a create handler (§17 "429 auténtico que rechaza
+  // solicitud"). This is the ONLY path to safeToRetry for a create.
+  if (rateSignal) {
+    return {
+      outcome: PUBLISH_OUTCOME.RATE_LIMITED,
+      errorCode,
+      retryAfterMs: retryAfterMs ?? null,
+      safeToRetry: true,
+      evidence: { phase: 'create', httpStatus, reason: 'rate limited before a create handler' },
+    };
+  }
+
+  // A typed error in `data.createPost`. Only the two error names actually
+  // observed in the Buffer docs are given a specific, non-ambiguous meaning;
+  // EVERY other typed error — current or future — falls through to the §6
+  // AMBIGUOUS catch-all. A regex on `__typename` is not used precisely because
+  // it could route a future error into `safeToRetry` (an automatic re-send).
+  if (typename && typename !== 'PostActionSuccess') {
+    if (typename === 'InvalidInputError') {
+      return {
+        outcome: PUBLISH_OUTCOME.REJECTED,
+        errorCode: typename,
+        evidence: { phase: 'create', typename, message: message ?? null },
+      };
+    }
+    if (typename === 'LimitReachedError') {
+      return {
+        outcome: PUBLISH_OUTCOME.CHANNEL_BLOCKED,
+        errorCode: typename,
+        warning: 'channel-queue-full',
+        // The create was rejected pre-handler → no effect. A later retry waits
+        // for the channel queue to drain; the ledger's attempt cap still applies.
+        safeToRetry: true,
+        evidence: { phase: 'create', typename, message: message ?? null },
+      };
+    }
+    return {
+      outcome: PUBLISH_OUTCOME.AMBIGUOUS,
+      errorCode: typename,
+      safeToRetry: false,
+      evidence: { phase: 'create', typename, message: message ?? null },
+    };
+  }
+
+  // A `PostActionSuccess` union with no usable post, a 2xx with no `data`, an
+  // unknown top-level error, a 5xx, a 4xx that is not auth/rate — all AMBIGUOUS
+  // after a possible send. Never a new create.
+  return {
+    outcome: PUBLISH_OUTCOME.AMBIGUOUS,
+    errorClass: cls === ERROR_CLASS.OK ? null : cls,
+    errorCode,
+    safeToRetry: false,
+    evidence: {
+      phase: 'create',
+      httpStatus,
+      reason: 'no confirmable post id and no proof of a no-effect rejection',
+      ...(typename ? { typename } : {}),
+      ...(errors.length > 0 ? { errors: errors.map((e) => e.message) } : {}),
+    },
+  };
+}
+
+// --- reconciliation matching (pure) --------------------------
+
+/**
+ * Match a channel's listed posts against the frozen copy. A match requires,
+ * simultaneously (§5 / §13 / task §5):
+ * - `post.channelId === channelId` (never adopt a foreign channel's post),
+ * - `post.text === frozenText` (whole-string equality, not a substring scan),
+ * - the canonical agrees: `post.externalLink` whole-URL-equals `canonicalUrl`,
+ *   OR there is no `externalLink` (X link posts carry the canonical only in the
+ *   text, which the text equality above already pins).
+ *
+ * Ids are de-duplicated across pages before the caller counts matches (§5
+ * "Considera IDs repetidos entre páginas").
+ *
+ * @param {{
+ *   posts: Array<{ id: string, status?: string|null, channelId?: string|null, text?: string|null, externalLink?: string|null, sentAt?: string|null }>,
+ *   frozenText: string,
+ *   canonicalUrl: string,
+ *   channelId: string,
+ * }} params
+ * @returns {Array<{ id: string, status: string|null, externalLink: string|null, sentAt: string|null }>}
+ */
+export function matchChannelPosts({ posts, frozenText, canonicalUrl, channelId }) {
+  if (!isNonEmptyString(frozenText) || !isNonEmptyString(canonicalUrl)) {
+    throw new BufferError('CONFIG', 'matchChannelPosts needs a frozen text and canonical url');
+  }
+  if (!isNonEmptyString(channelId)) {
+    throw new BufferError('CONFIG', 'matchChannelPosts needs the expected channelId');
+  }
+  const seen = new Set();
+  const matches = [];
+  for (const raw of Array.isArray(posts) ? posts : []) {
+    const post = normalizePost(raw);
+    if (!post || seen.has(post.id)) continue;
+    seen.add(post.id);
+    if (post.channelId !== channelId) continue;
+    if (post.text !== frozenText) continue;
+    if (post.externalLink && !sameCanonical(post.externalLink, canonicalUrl)) continue;
+    matches.push({
+      id: post.id,
+      status: post.status,
+      externalLink: post.externalLink,
+      sentAt: post.sentAt,
+    });
+  }
+  return matches;
+}
+
+// --- client -------------------------------------------------------
+
+/**
+ * @typedef {object} DiscoveryResult
+ * @property {boolean} ok
+ * @property {string} outcome one of {@link DISCOVERY_OUTCOME}
+ * @property {Record<string, { channelId: string, service: string, type: string }>} [channels]
+ *   the validated channels, keyed by platform (only on `ok`)
+ * @property {object} diagnostics structured, non-secret detail — always present
+ */
+
+/**
+ * @typedef {object} SingleReadResult
+ * @property {string} state one of {@link READ_STATE}
+ * @property {object} [post] the normalized post (on `present`)
+ * @property {object} evidence
+ */
+
+/**
+ * Create a Buffer client bound to one API key + organization. The key lives only
+ * in this closure; nothing is persisted and nothing happens until a method is
+ * called (no session, no import-time I/O).
+ *
+ * @param {{
+ *   fetchImpl: import('../http.js').FetchLike,
+ *   apiKey: string,
+ *   organizationId: string,
+ *   readTimeoutMs?: number,
+ *   writeTimeoutMs?: number,
+ * }} config
+ */
+export function createBufferClient(config) {
+  const {
+    fetchImpl,
+    apiKey,
+    organizationId,
+    readTimeoutMs = DEFAULT_READ_TIMEOUT_MS,
+    writeTimeoutMs = DEFAULT_WRITE_TIMEOUT_MS,
+  } = config || {};
+
+  if (typeof fetchImpl !== 'function') {
+    throw new BufferError('CONFIG', 'fetchImpl must be injected');
+  }
+  if (!isNonEmptyString(apiKey)) {
+    throw new BufferError('CONFIG', 'apiKey is required');
+  }
+  if (!ORG_ID_RE.test(String(organizationId))) {
+    throw new BufferError('CONFIG', 'organizationId must be a Buffer organization id');
+  }
+
+  const secrets = [apiKey];
+
+  function baseOptions(timeoutMs) {
+    return {
+      fetchImpl,
+      method: 'POST',
+      headers: {
+        Authorization: `Bearer ${apiKey}`,
+        'Content-Type': 'application/json',
+      },
+      allowedHosts: [BUFFER_API_HOST],
+      // One fetch, no redirect-following: a fixed API endpoint must never send
+      // the Bearer key to a redirect target (§18), and a create must be exactly
+      // one request (§13).
+      followRedirects: false,
+      timeoutMs,
+      secrets,
+    };
+  }
+
+  /**
+   * Issue one GraphQL request. Returns `{ result, json }` for any HTTP status;
+   * throws {@link HttpError} only when no usable response was produced. Never
+   * retries.
+   */
+  async function gql(query, variables, timeoutMs) {
+    return requestJson(BUFFER_API_URL, {
+      ...baseOptions(timeoutMs),
+      body: JSON.stringify(variables === undefined ? { query } : { query, variables }),
+    });
+  }
+
+  // --- discovery ------------------------------------------------
+
+  /**
+   * Verify the configured organization and channels (task §2 / §13 / §22
+   * phase 0). Read-only. Validates, for each configured platform, that the
+   * channel id belongs to the organization and its `service` equals the
+   * configured value (or {@link DEFAULT_CHANNEL_SERVICE}); `type` is validated
+   * only when the caller pins it explicitly, and the observed literal is always
+   * reported back in `diagnostics` for the doctor to record. Never auto-selects
+   * the first channel; never substitutes a Page for a profile.
+   *
+   * @param {{
+   *   expected: Record<string, { channelId: string, service?: string, type?: string }>,
+   * }} params
+   * @returns {Promise<DiscoveryResult>}
+   */
+  async function inspectChannels({ expected }) {
+    if (!isPlainObject(expected) || Object.keys(expected).length === 0) {
+      throw new BufferError('CONFIG', 'inspectChannels needs an `expected` channel map');
+    }
+    for (const [platform, cfg] of Object.entries(expected)) {
+      if (!BUFFER_PLATFORMS.includes(platform)) {
+        throw new BufferError('CONFIG', `unknown Buffer platform ${JSON.stringify(platform)}`);
+      }
+      if (!isPlainObject(cfg) || !CHANNEL_ID_RE.test(String(cfg.channelId))) {
+        throw new BufferError('CONFIG', `expected.${platform}.channelId is missing or malformed`);
+      }
+    }
+
+    // 1. Organizations — the configured org must be present.
+    let orgs;
+    try {
+      const { result, json } = await gql(GQL.ACCOUNT_ORGANIZATIONS, undefined, readTimeoutMs);
+      const errs = topLevelErrors(json);
+      if (classifyStatus(result.status, result.headers) !== ERROR_CLASS.OK || errs.length > 0) {
+        return readFailed('account read failed', {
+          httpStatus: result.status,
+          errors: errs.map((e) => e.message),
+        });
+      }
+      orgs =
+        isPlainObject(json.data) && isPlainObject(json.data.account)
+          ? json.data.account.organizations
+          : null;
+    } catch (error) {
+      return readFailed('account read threw', transportEvidence(error));
+    }
+    if (
+      !Array.isArray(orgs) ||
+      !orgs.some((o) => isPlainObject(o) && String(o.id) === organizationId)
+    ) {
+      return {
+        ok: false,
+        outcome: DISCOVERY_OUTCOME.ORG_NOT_FOUND,
+        diagnostics: {
+          configured_organization_id: organizationId,
+          visible_organization_ids: Array.isArray(orgs)
+            ? orgs.filter(isPlainObject).map((o) => String(o.id))
+            : [],
+        },
+      };
+    }
+
+    // 2. Channels of that organization.
+    let channels;
+    try {
+      const { result, json } = await gql(GQL.CHANNELS, { organizationId }, readTimeoutMs);
+      const errs = topLevelErrors(json);
+      if (classifyStatus(result.status, result.headers) !== ERROR_CLASS.OK || errs.length > 0) {
+        return readFailed('channels read failed', {
+          httpStatus: result.status,
+          errors: errs.map((e) => e.message),
+        });
+      }
+      channels = isPlainObject(json.data) ? json.data.channels : null;
+    } catch (error) {
+      return readFailed('channels read threw', transportEvidence(error));
+    }
+    if (!Array.isArray(channels)) {
+      return readFailed('channels read returned no list', {});
+    }
+    const byId = new Map(
+      channels
+        .filter((c) => isPlainObject(c) && isNonEmptyString(c.id))
+        .map((c) => [String(c.id), c])
+    );
+
+    const validated = {};
+    const perChannel = {};
+    for (const [platform, cfg] of Object.entries(expected)) {
+      const wantService = isNonEmptyString(cfg.service)
+        ? String(cfg.service)
+        : (DEFAULT_CHANNEL_SERVICE[platform] ?? null);
+      // `type` is validated only when explicitly configured — there is no
+      // guessed `ChannelType` literal to fail closed against.
+      const wantType = isNonEmptyString(cfg.type) ? String(cfg.type) : null;
+      const channelId = String(cfg.channelId);
+      const found = byId.get(channelId);
+      if (!found) {
+        return {
+          ok: false,
+          outcome: DISCOVERY_OUTCOME.CHANNEL_NOT_IN_ORG,
+          diagnostics: {
+            platform,
+            configured_channel_id: channelId,
+            organization_channel_ids: [...byId.keys()],
+          },
+        };
+      }
+      const observedService = isNonEmptyString(found.service) ? String(found.service) : null;
+      const observedType = isNonEmptyString(found.type) ? String(found.type) : null;
+      if (wantService && observedService !== wantService) {
+        return {
+          ok: false,
+          outcome: DISCOVERY_OUTCOME.SERVICE_MISMATCH,
+          diagnostics: {
+            platform,
+            configured_channel_id: channelId,
+            expected_service: wantService,
+            observed_service: observedService,
+          },
+        };
+      }
+      if (wantType && observedType !== wantType) {
+        return {
+          ok: false,
+          outcome: DISCOVERY_OUTCOME.TYPE_MISMATCH,
+          diagnostics: {
+            platform,
+            configured_channel_id: channelId,
+            expected_type: wantType,
+            observed_type: observedType,
+          },
+        };
+      }
+      validated[platform] = { channelId, service: observedService, type: observedType };
+      perChannel[platform] = {
+        name: isNonEmptyString(found.name) ? String(found.name) : null,
+        // The real, observed `ChannelType` literal — pin this in config (§22 phase 0).
+        observed_service: observedService,
+        observed_type: observedType,
+        type_enforced: wantType != null,
+      };
+    }
+
+    return {
+      ok: true,
+      outcome: DISCOVERY_OUTCOME.OK,
+      channels: validated,
+      diagnostics: { organization_id: organizationId, channels: perChannel },
+    };
+
+    function readFailed(reason, extra) {
+      return {
+        ok: false,
+        outcome: DISCOVERY_OUTCOME.READ_FAILED,
+        diagnostics: { reason, ...extra },
+      };
+    }
+  }
+
+  // --- create --------------------------------------------------
+
+  /**
+   * Create one Buffer post from a FROZEN {@link import('../content.js').SocialPost}.
+   * Immediate publication: `mode: shareNow`, `schedulingType: automatic`,
+   * `needsApproval: false`, `saveToDraft: false`. Link post for Facebook /
+   * LinkedIn (`assets: [{ link: { url: canonical } }]`); no asset for X
+   * (`assets: []`). Exactly one HTTP request; no retry anywhere.
+   *
+   * @param {{ post: import('../content.js').SocialPost }} params
+   * @returns {Promise<PublishResult>}
+   */
+  async function create({ post }) {
+    if (!isPlainObject(post)) throw new BufferError('CONFIG', 'create needs a SocialPost object');
+    if (!BUFFER_PLATFORMS.includes(post.platform)) {
+      throw new BufferError(
+        'CONFIG',
+        `create is Buffer-only (facebook/x/linkedin), got ${JSON.stringify(post.platform)}`
+      );
+    }
+    if (!CHANNEL_ID_RE.test(String(post.account_key))) {
+      throw new BufferError('CONFIG', 'post.account_key must be the Buffer channel id');
+    }
+    if (typeof post.text !== 'string' || post.text === '') {
+      throw new BufferError('CONFIG', 'post.text is empty');
+    }
+    if (!isNonEmptyString(post.canonical_url)) {
+      throw new BufferError('CONFIG', 'post.canonical_url is required');
+    }
+
+    const channelId = String(post.account_key);
+    const assets = post.platform === 'x' ? [] : [{ link: { url: String(post.canonical_url) } }];
+
+    const variables = {
+      channelId,
+      text: post.text,
+      mode: 'shareNow',
+      schedulingType: 'automatic',
+      needsApproval: false,
+      saveToDraft: false,
+      assets,
+    };
+
+    let result;
+    let json;
+    try {
+      ({ result, json } = await gql(GQL.CREATE_POST, variables, writeTimeoutMs));
+    } catch (error) {
+      return classifyCreateThrow(error);
+    }
+    return classifyCreateResponse({
+      httpStatus: result.status,
+      headers: result.headers,
+      json,
+      retryAfterMs: result.retryAfterMs ?? null,
+      expectedChannelId: channelId,
+    });
+  }
+
+  /**
+   * Map a thrown transport failure on the create path. Buffer has no idempotency
+   * key, so a thrown error is exactly the §6 "no hay evidencia suficiente de
+   * rechazo sin efecto" case: classify AMBIGUOUS, never a new create — even a
+   * DNS failure, which §17 would permit retrying, is safer resolved by a read
+   * (`reconcile` finds nothing → stays uncertain → human) than by a blind
+   * re-send against a provider that cannot dedupe.
+   */
+  function classifyCreateThrow(error) {
+    const errorClass = error instanceof HttpError ? error.errorClass : ERROR_CLASS.CONNECTION;
+    const sanitized =
+      error instanceof HttpError ? error.sanitizedMessage : 'create transport failure';
+    return {
+      outcome: PUBLISH_OUTCOME.AMBIGUOUS,
+      errorClass,
+      errorCode: null,
+      retryAfterMs: error instanceof HttpError ? (error.retryAfterMs ?? null) : null,
+      safeToRetry: false,
+      evidence: {
+        phase: 'create',
+        reason: 'transport failure / lost response',
+        message: sanitized,
+      },
+    };
+  }
+
+  // --- reads --------------------------------------------------
+
+  /**
+   * Read one post by Buffer id (`post(input: { id })`). Used for polling an
+   * ACCEPTED entry (task §4). Read-only; a failed read keeps the caller's id and
+   * status (returns `unknown`), a `NOT_FOUND` returns `absent` — neither
+   * authorises re-creating the post.
+   *
+   * @param {{ id: string }} params
+   * @returns {Promise<SingleReadResult>}
+   */
+  async function get({ id }) {
+    if (!POST_ID_RE.test(String(id))) throw new BufferError('CONFIG', 'get needs a Buffer post id');
+    let result;
+    let json;
+    try {
+      ({ result, json } = await gql(GQL.POST_BY_ID, { id: String(id) }, readTimeoutMs));
+    } catch (error) {
+      return {
+        state: READ_STATE.UNKNOWN,
+        evidence: { reason: 'read threw', ...transportEvidence(error) },
+      };
+    }
+    return interpretSingleRead(result, isPlainObject(json?.data) ? json.data.post : null, json);
+  }
+
+  /**
+   * Read up to {@link MAX_BATCH_GET} posts in one aliased request (task §4 —
+   * "lecturas agrupadas necesarias para el futuro polling"). Returns a map from
+   * id to {@link SingleReadResult}; ids beyond the cap are rejected as a CONFIG
+   * error rather than silently split (the orchestrator owns batching cadence).
+   *
+   * Per-alias resolution is exact: an alias with a post object → `present`, an
+   * alias whose field is `null` / absent → `unknown`. A *single top-level*
+   * `NOT_FOUND` in a batched response is NOT attributable to one alias, so
+   * {@link interpretSingleRead} would mark every alias in that batch `absent`.
+   * `absent` only drives an `alert` (never a create), so this is safe today —
+   * but package 8 should prefer per-id {@link get} when it needs a trustworthy
+   * `absent`, and treat a batched `absent` as "re-check individually".
+   *
+   * @param {{ ids: string[] }} params
+   * @returns {Promise<Record<string, SingleReadResult>>}
+   */
+  async function getMany({ ids }) {
+    if (!Array.isArray(ids) || ids.length === 0) {
+      throw new BufferError('CONFIG', 'getMany needs a non-empty id list');
+    }
+    if (ids.length > MAX_BATCH_GET) {
+      throw new BufferError('CONFIG', `getMany accepts at most ${MAX_BATCH_GET} ids per request`);
+    }
+    for (const id of ids) {
+      if (!POST_ID_RE.test(String(id)))
+        throw new BufferError('CONFIG', `malformed post id ${JSON.stringify(id)}`);
+    }
+    const doc = batchPostsDocument(ids.length);
+    const variables = Object.fromEntries(ids.map((id, i) => [`p${i}`, String(id)]));
+
+    let result;
+    let json;
+    try {
+      ({ result, json } = await gql(doc, variables, readTimeoutMs));
+    } catch (error) {
+      const ev = { reason: 'batch read threw', ...transportEvidence(error) };
+      return Object.fromEntries(
+        ids.map((id) => [String(id), { state: READ_STATE.UNKNOWN, evidence: ev }])
+      );
+    }
+    const out = {};
+    const data = isPlainObject(json?.data) ? json.data : {};
+    ids.forEach((id, i) => {
+      out[String(id)] = interpretSingleRead(result, data[`a${i}`] ?? null, json);
+    });
+    return out;
+  }
+
+  function interpretSingleRead(result, rawPost, json) {
+    const cls = classifyStatus(result.status, result.headers);
+    const errs = topLevelErrors(json);
+    const code = firstErrorCode(errs);
+    const post = normalizePost(rawPost);
+    if (post) {
+      return { state: READ_STATE.PRESENT, post, evidence: { httpStatus: result.status } };
+    }
+    if (cls === ERROR_CLASS.AUTH || code === 'UNAUTHORIZED' || code === 'FORBIDDEN') {
+      return {
+        state: READ_STATE.UNKNOWN,
+        evidence: { reason: 'auth', httpStatus: result.status, code },
+      };
+    }
+    if (cls === ERROR_CLASS.NOT_FOUND || code === 'NOT_FOUND') {
+      return { state: READ_STATE.ABSENT, evidence: { httpStatus: result.status, code } };
+    }
+    return {
+      state: READ_STATE.UNKNOWN,
+      evidence: { httpStatus: result.status, code, errors: errs.map((e) => e.message) },
+    };
+  }
+
+  /**
+   * List every post on a channel, all statuses, paginating up to
+   * {@link MAX_RECONCILE_PAGES} pages (§13). Returns the de-duplicated posts, and
+   * `complete: false` when pagination was truncated, a page errored, or a page
+   * body was partial — the caller must NOT treat that as a full view (§5).
+   *
+   * @param {{ channelId: string, maxPages?: number, pageSize?: number }} params
+   * @returns {Promise<{ posts: object[], complete: boolean, pages: number, evidence: object }>}
+   */
+  async function listChannelPosts({
+    channelId,
+    maxPages = MAX_RECONCILE_PAGES,
+    pageSize = RECONCILE_PAGE_SIZE,
+  }) {
+    if (!CHANNEL_ID_RE.test(String(channelId))) {
+      throw new BufferError('CONFIG', 'listChannelPosts needs a channelId');
+    }
+    const cap = Math.min(Math.max(1, Math.trunc(maxPages)), MAX_RECONCILE_PAGES);
+    const first = Math.min(Math.max(1, Math.trunc(pageSize)), RECONCILE_PAGE_SIZE);
+    const byId = new Map();
+    let after = null;
+    let pages = 0;
+    let complete = false;
+    const notes = [];
+
+    while (pages < cap) {
+      pages += 1;
+      let result;
+      let json;
+      try {
+        ({ result, json } = await gql(
+          GQL.POSTS_BY_CHANNEL,
+          { organizationId, channelId: String(channelId), first, after },
+          readTimeoutMs
+        ));
+      } catch (error) {
+        notes.push({ page: pages, reason: 'read threw', ...transportEvidence(error) });
+        return { posts: [...byId.values()], complete: false, pages, evidence: { notes } };
+      }
+      const errs = topLevelErrors(json);
+      if (classifyStatus(result.status, result.headers) !== ERROR_CLASS.OK || errs.length > 0) {
+        notes.push({ page: pages, httpStatus: result.status, errors: errs.map((e) => e.message) });
+        return { posts: [...byId.values()], complete: false, pages, evidence: { notes } };
+      }
+      const conn = isPlainObject(json.data) ? json.data.posts : null;
+      if (!isPlainObject(conn) || !Array.isArray(conn.edges)) {
+        notes.push({ page: pages, reason: 'partial page body' });
+        return { posts: [...byId.values()], complete: false, pages, evidence: { notes } };
+      }
+      for (const edge of conn.edges) {
+        const post = normalizePost(isPlainObject(edge) ? edge.node : null);
+        if (post && !byId.has(post.id)) byId.set(post.id, post);
+      }
+      const pageInfo = isPlainObject(conn.pageInfo) ? conn.pageInfo : null;
+      if (!pageInfo || typeof pageInfo.hasNextPage !== 'boolean') {
+        notes.push({ page: pages, reason: 'missing pageInfo.hasNextPage' });
+        return { posts: [...byId.values()], complete: false, pages, evidence: { notes } };
+      }
+      if (!pageInfo.hasNextPage) {
+        complete = true;
+        break;
+      }
+      if (!isNonEmptyString(pageInfo.endCursor)) {
+        notes.push({ page: pages, reason: 'hasNextPage but no endCursor' });
+        return { posts: [...byId.values()], complete: false, pages, evidence: { notes } };
+      }
+      after = String(pageInfo.endCursor);
+    }
+
+    if (!complete) notes.push({ reason: 'page cap reached before hasNextPage went false', cap });
+    return { posts: [...byId.values()], complete, pages, evidence: { notes } };
+  }
+
+  // --- reconcile ----------------------------------------------
+
+  /**
+   * Reconcile one AMBIGUOUS pair by reading Buffer — NEVER by creating another
+   * post (§5 / §6). Two modes:
+   *
+   * - a `providerId` is known (a partial create response carried an id): read
+   *   that post, check it is on the expected channel and matches the frozen copy.
+   * - no `providerId`: list the channel (bounded pagination) and match by
+   *   `channelId` + exact frozen text + whole-URL canonical.
+   *
+   * Decision rules (§5): exactly one match → adopt (PUBLISHED if `sent`, else
+   * ACCEPTED); more than one → conflict; zero matches → uncertain (NOT proof of
+   * absence); any truncated/partial/failed read → uncertain (NO uniqueness
+   * claim). Returns evidence; the descriptor is built by
+   * {@link reconciliationParams}.
+   *
+   * @param {{
+   *   channelId: string,
+   *   providerId?: string|null,
+   *   frozenText: string,
+   *   canonicalUrl: string,
+   *   maxPages?: number,
+   * }} params
+   * @returns {Promise<{ decision: string, providerId?: string, externalUrl?: string|null, status?: string|null, matchIds?: string[], evidence: object }>}
+   */
+  async function reconcile({ channelId, providerId, frozenText, canonicalUrl, maxPages }) {
+    if (!CHANNEL_ID_RE.test(String(channelId))) {
+      throw new BufferError('CONFIG', 'reconcile needs a channelId');
+    }
+    if (!isNonEmptyString(frozenText) || !isNonEmptyString(canonicalUrl)) {
+      throw new BufferError('CONFIG', 'reconcile needs the frozen text and canonical url');
+    }
+
+    if (isNonEmptyString(providerId)) {
+      const read = await get({ id: String(providerId) });
+      if (read.state === READ_STATE.ABSENT) {
+        // §4: a 404 of a known id does NOT authorise re-creating it, and is not
+        // proof it was never accepted — a human confirms.
+        return {
+          decision: RECONCILE_DECISION.UNCERTAIN,
+          evidence: { mode: 'by-id', reason: 'known id is absent', read: read.evidence },
+        };
+      }
+      if (read.state !== READ_STATE.PRESENT) {
+        return {
+          decision: RECONCILE_DECISION.UNCERTAIN,
+          evidence: { mode: 'by-id', reason: 'read failed', read: read.evidence },
+        };
+      }
+      const p = read.post;
+      if (p.channelId !== String(channelId)) {
+        return {
+          decision: RECONCILE_DECISION.CONFLICT,
+          evidence: {
+            mode: 'by-id',
+            reason: 'id is on a different channel',
+            expected: String(channelId),
+            got: p.channelId,
+          },
+        };
+      }
+      const contentOk =
+        p.text === frozenText && (!p.externalLink || sameCanonical(p.externalLink, canonicalUrl));
+      if (!contentOk) {
+        return {
+          decision: RECONCILE_DECISION.CONFLICT,
+          evidence: { mode: 'by-id', reason: 'a different post occupies this id', found: clip(p) },
+        };
+      }
+      if (p.status === 'error') {
+        return {
+          decision: RECONCILE_DECISION.CONFLICT,
+          providerId: p.id,
+          evidence: {
+            mode: 'by-id',
+            reason: 'provider reports the post errored',
+            status: p.status,
+          },
+        };
+      }
+      return {
+        decision:
+          postStatusAction(p.status) === 'published'
+            ? RECONCILE_DECISION.CONFIRMED
+            : RECONCILE_DECISION.ADOPT_ACCEPTED,
+        providerId: p.id,
+        externalUrl: p.externalLink,
+        status: p.status,
+        evidence: { mode: 'by-id', status: p.status },
+      };
+    }
+
+    const listed = await listChannelPosts({ channelId: String(channelId), maxPages });
+    const matches = matchChannelPosts({
+      posts: listed.posts,
+      frozenText,
+      canonicalUrl,
+      channelId: String(channelId),
+    });
+    const evidence = {
+      mode: 'by-list',
+      pages: listed.pages,
+      listComplete: listed.complete,
+      scanned: listed.posts.length,
+      matched: matches.length,
+      matchIds: matches.map((m) => m.id),
+      list: listed.evidence,
+    };
+
+    if (matches.length > 1) {
+      return {
+        decision: RECONCILE_DECISION.CONFLICT,
+        matchIds: matches.map((m) => m.id),
+        evidence,
+      };
+    }
+    if (!listed.complete) {
+      // A truncated / partial / failed listing cannot affirm global uniqueness
+      // (§5), even a single match — a second duplicate could sit on an unseen
+      // page. No adoption.
+      return { decision: RECONCILE_DECISION.UNCERTAIN, evidence };
+    }
+    if (matches.length === 1) {
+      const m = matches[0];
+      return {
+        decision:
+          postStatusAction(m.status) === 'published'
+            ? RECONCILE_DECISION.CONFIRMED
+            : RECONCILE_DECISION.ADOPT_ACCEPTED,
+        providerId: m.id,
+        externalUrl: m.externalLink,
+        status: m.status,
+        evidence,
+      };
+    }
+    // Zero matches over a complete listing — still NOT proof of absence (§5).
+    return { decision: RECONCILE_DECISION.UNCERTAIN, evidence };
+  }
+
+  return {
+    /** @internal test seam — the organization this client is bound to. */
+    organizationId,
+    inspectChannels,
+    create,
+    get,
+    getMany,
+    listChannelPosts,
+    reconcile,
+  };
+}
+
+function transportEvidence(error) {
+  return {
+    errorClass: error instanceof HttpError ? error.errorClass : ERROR_CLASS.CONNECTION,
+    ...(error instanceof HttpError && error.status ? { httpStatus: error.status } : {}),
+  };
+}
+
+// --- translation to the ledger's input contracts ---------------
+
+/**
+ * @typedef {object} LedgerSendResult the shape `state.recordResult` accepts (its
+ *   `SendResult` typedef).
+ * @property {string} status one of the `state.STATUS` values
+ * @property {string} [providerId]
+ * @property {string} [externalUrl]
+ * @property {string} [errorClass]
+ * @property {boolean} [safeToRetry]
+ * @property {string} [retryAt] ISO
+ * @property {Record<string, unknown>} [evidence]
+ */
+
+/**
+ * Translate a {@link PublishResult} from `create` into what
+ * `state.recordResult` accepts. `create` runs against a `PUBLISHING` entry, so
+ * the reachable targets are `ACCEPTED | PUBLISHED | AMBIGUOUS | RETRYABLE |
+ * FAILED_PERMANENT`; `state.recordResult` refuses a `RETRYABLE` without
+ * `safeToRetry === true` AND an ISO `retryAt` (`UNSAFE_RETRYABLE`).
+ *
+ * | outcome         | result                                                                     |
+ * |-----------------|----------------------------------------------------------------------------|
+ * | confirmed       | `{ recordResult: { status:'PUBLISHED', providerId, externalUrl } }`         |
+ * | accepted        | `{ recordResult: { status:'ACCEPTED', providerId, externalUrl? }, warning? }` — id recorded before polling; `warning` set for `draft`/`needs_approval` so the orchestrator can stop the channel (§13) |
+ * | failed-with-id  | `{ recordResult: { status:'FAILED_PERMANENT', providerId } }` — keep the id; a human repairs that object; no new create (§13/§17) |
+ * | rejected        | `{ recordResult: { status:'FAILED_PERMANENT', errorClass? } }`             |
+ * | channel-blocked | `LimitReachedError` (channel queue full, rejected pre-handler) → `{ recordResult: { status:'RETRYABLE', safeToRetry:true, retryAt }, warning:'channel-queue-full' }`. (A `channel-blocked` without `safeToRetry` maps to `FAILED_PERMANENT`, but nothing currently produces that.) |
+ * | rate-limited    | `{ recordResult: { status:'RETRYABLE', safeToRetry:true, retryAt } }` — §17 "429 auténtico que rechaza solicitud → Sí"; provable no-effect only because there is no post id in the response AND `../http.js` follows no redirects. The retry re-freezes a fresh payload via a new `recordIntent`; Buffer has no fixed-key backstop. |
+ * | auth-invalid    | `{ halt:'auth-invalid' }` — stop the run; if the (contradictory) response also carried a post id, `{ halt:'auth-invalid', recordResult:{ status:'ACCEPTED', providerId } }` so the id survives the key rotation |
+ * | ambiguous       | `{ recordResult: { status:'AMBIGUOUS', errorClass? } }` — reconcile next    |
+ *
+ * @param {PublishResult} pub
+ * @param {{ now?: () => number, retryDelayMs?: number }} [options]
+ * @returns {{ recordResult?: LedgerSendResult, halt?: string, warning?: string, evidence?: Record<string, unknown> }}
+ */
+export function toRecordResult(
+  pub,
+  { now = () => Date.now(), retryDelayMs = DEFAULT_RETRY_DELAY_MS } = {}
+) {
+  if (!isPlainObject(pub) || !isNonEmptyString(pub.outcome)) {
+    throw new BufferError('CONFIG', 'toRecordResult needs a PublishResult with an outcome');
+  }
+  const evidence = isPlainObject(pub.evidence) ? pub.evidence : {};
+  const retryAtFrom = (extraMs) => {
+    const at = typeof now === 'function' ? now() : Date.now();
+    const wait = Math.max(retryDelayMs, Number(extraMs) || 0);
+    return new Date(at + wait).toISOString();
+  };
+
+  switch (pub.outcome) {
+    case PUBLISH_OUTCOME.CONFIRMED:
+      return {
+        recordResult: {
+          status: 'PUBLISHED',
+          providerId: pub.providerId,
+          ...(pub.externalUrl ? { externalUrl: pub.externalUrl } : {}),
+          evidence,
+        },
+      };
+    case PUBLISH_OUTCOME.ACCEPTED:
+      return {
+        recordResult: {
+          status: 'ACCEPTED',
+          providerId: pub.providerId,
+          ...(pub.externalUrl ? { externalUrl: pub.externalUrl } : {}),
+          evidence,
+        },
+        ...(pub.warning ? { warning: pub.warning } : {}),
+      };
+    case PUBLISH_OUTCOME.FAILED_WITH_ID:
+      return {
+        recordResult: {
+          status: 'FAILED_PERMANENT',
+          providerId: pub.providerId,
+          ...(pub.errorClass ? { errorClass: pub.errorClass } : {}),
+          evidence,
+        },
+      };
+    case PUBLISH_OUTCOME.REJECTED:
+      return {
+        recordResult: {
+          status: 'FAILED_PERMANENT',
+          ...(pub.errorClass ? { errorClass: pub.errorClass } : {}),
+          evidence,
+        },
+      };
+    case PUBLISH_OUTCOME.CHANNEL_BLOCKED:
+      if (pub.safeToRetry === true) {
+        return {
+          recordResult: {
+            status: 'RETRYABLE',
+            safeToRetry: true,
+            retryAt: retryAtFrom(pub.retryAfterMs),
+            evidence,
+          },
+          ...(pub.warning ? { warning: pub.warning } : {}),
+        };
+      }
+      return {
+        recordResult: { status: 'FAILED_PERMANENT', evidence },
+        ...(pub.warning ? { warning: pub.warning } : {}),
+      };
+    case PUBLISH_OUTCOME.RATE_LIMITED:
+      return {
+        recordResult: {
+          status: 'RETRYABLE',
+          safeToRetry: true,
+          retryAt: retryAtFrom(pub.retryAfterMs),
+          evidence,
+        },
+      };
+    case PUBLISH_OUTCOME.AUTH_INVALID:
+      // Halt the run. If the contradictory response also carried a post id,
+      // persist it as ACCEPTED first so it is not lost across the key rotation.
+      return {
+        halt: 'auth-invalid',
+        ...(isNonEmptyString(pub.providerId)
+          ? { recordResult: { status: 'ACCEPTED', providerId: pub.providerId, evidence } }
+          : {}),
+        evidence,
+      };
+    case PUBLISH_OUTCOME.AMBIGUOUS:
+      return {
+        recordResult: {
+          status: 'AMBIGUOUS',
+          ...(pub.errorClass ? { errorClass: pub.errorClass } : {}),
+          evidence,
+        },
+      };
+    default:
+      throw new BufferError(
+        'CONFIG',
+        `unmappable PublishResult outcome ${JSON.stringify(pub.outcome)}`
+      );
+  }
+}
+
+/**
+ * Translate a `get` {@link SingleReadResult} — a poll of an ACCEPTED entry —
+ * into a `state.recordResult` descriptor. From `ACCEPTED` the ONLY legal targets
+ * are `PUBLISHED` and `FAILED_PERMANENT` (`state.RESULT_TRANSITIONS`); anything
+ * else emits **no ledger call**, keeping the id and status intact (task §4 "un
+ * 404 de un ID conocido no autoriza recrearlo").
+ *
+ * | read                              | descriptor                                              |
+ * |-----------------------------------|--------------------------------------------------------|
+ * | present, `sent`, channel matches  | `{ call:'recordResult', result:{ status:'PUBLISHED', providerId, externalUrl } }` |
+ * | present, `error`                  | `{ call:'recordResult', result:{ status:'FAILED_PERMANENT', providerId } }` |
+ * | present, other status             | `{ call:null, note:'still pending' }`                    |
+ * | present, channel mismatch         | `{ call:null, alert:'channel-mismatch' }`                |
+ * | absent (known id 404)             | `{ call:null, alert:'known-id-absent' }`                 |
+ * | unknown (read failed)             | `{ call:null, note:'read failed' }`                      |
+ *
+ * @param {SingleReadResult} read
+ * @param {{ expectedChannelId: string, providerId: string }} ctx
+ * @returns {{ call: 'recordResult'|null, result?: LedgerSendResult, note?: string, alert?: string, evidence: object }}
+ */
+export function pollToRecordResult(read, { expectedChannelId, providerId } = {}) {
+  if (!isPlainObject(read) || !isNonEmptyString(read.state)) {
+    throw new BufferError('CONFIG', 'pollToRecordResult needs a SingleReadResult');
+  }
+  const evidence = isPlainObject(read.evidence) ? read.evidence : {};
+
+  if (read.state === READ_STATE.ABSENT) {
+    return { call: null, alert: 'known-id-absent', evidence };
+  }
+  if (read.state !== READ_STATE.PRESENT) {
+    return { call: null, note: 'read failed; keep id and status', evidence };
+  }
+  const p = read.post;
+  if (expectedChannelId && p.channelId && p.channelId !== String(expectedChannelId)) {
+    return { call: null, alert: 'channel-mismatch', evidence: { ...evidence, got: p.channelId } };
+  }
+  const action = postStatusAction(p.status);
+  if (action === 'published') {
+    return {
+      call: 'recordResult',
+      result: {
+        status: 'PUBLISHED',
+        providerId: providerId ?? p.id,
+        ...(p.externalLink ? { externalUrl: p.externalLink } : {}),
+        evidence: { ...evidence, status: p.status },
+      },
+      evidence,
+    };
+  }
+  if (action === 'failed') {
+    return {
+      call: 'recordResult',
+      result: {
+        status: 'FAILED_PERMANENT',
+        providerId: providerId ?? p.id,
+        evidence: { ...evidence, status: p.status },
+      },
+      evidence,
+    };
+  }
+  return { call: null, note: `still ${p.status ?? 'pending'}`, evidence };
+}
+
+/**
+ * Translate a `reconcile` decision into a `state.recordReconciliation`
+ * descriptor. Returns a descriptor; it does NOT call the ledger — the
+ * orchestrator re-applies its controls first (task §6 "La reconciliación
+ * devuelve evidencia; nunca ejecuta otro create"). All descriptors here are
+ * automatic `adopt` / `block`; a human `authorize-retry` is never emitted from
+ * an ambiguous Buffer pair (§15 / §28: kept blocked, "preferir entrega omitida
+ * a duplicación incierta").
+ *
+ * | decision       | descriptor                                                                        |
+ * |----------------|----------------------------------------------------------------------------------|
+ * | confirmed      | `{ call:'recordReconciliation', kind:'adopt', target:'PUBLISHED', providerId, externalUrl }` |
+ * | adopt-accepted | `{ call:'recordReconciliation', kind:'adopt', target:'ACCEPTED', providerId }`    |
+ * | conflict       | `{ call:'recordReconciliation', kind:'block', resolution:{ actor, reason, evidence } }` |
+ * | uncertain      | `{ call:null, note }` — keep the reservation, re-check next run                    |
+ *
+ * @param {{ decision: string, providerId?: string, externalUrl?: string|null, status?: string|null, matchIds?: string[], evidence?: object }} recon
+ * @param {{ actor?: string, reason?: string }} [meta]
+ */
+export function reconciliationParams(recon, { actor = 'social-orchestrator', reason } = {}) {
+  if (!isPlainObject(recon) || !isNonEmptyString(recon.decision)) {
+    throw new BufferError('CONFIG', 'reconciliationParams needs a decision');
+  }
+  const evidence = isPlainObject(recon.evidence) ? recon.evidence : {};
+  switch (recon.decision) {
+    case RECONCILE_DECISION.CONFIRMED:
+      return {
+        call: 'recordReconciliation',
+        kind: 'adopt',
+        target: 'PUBLISHED',
+        ...(isNonEmptyString(recon.providerId) ? { providerId: recon.providerId } : {}),
+        ...(isNonEmptyString(recon.externalUrl) ? { externalUrl: recon.externalUrl } : {}),
+        resolution: {
+          actor,
+          reason: reason ?? 'a single Buffer post matches the frozen copy and is sent',
+          evidence,
+        },
+      };
+    case RECONCILE_DECISION.ADOPT_ACCEPTED:
+      return {
+        call: 'recordReconciliation',
+        kind: 'adopt',
+        target: 'ACCEPTED',
+        ...(isNonEmptyString(recon.providerId) ? { providerId: recon.providerId } : {}),
+        ...(isNonEmptyString(recon.externalUrl) ? { externalUrl: recon.externalUrl } : {}),
+        resolution: {
+          actor,
+          reason: reason ?? 'a single Buffer post matches the frozen copy; not yet sent',
+          evidence,
+        },
+      };
+    case RECONCILE_DECISION.CONFLICT:
+      return {
+        call: 'recordReconciliation',
+        kind: 'block',
+        resolution: {
+          actor,
+          reason: reason ?? 'more than one match, a foreign channel, or a different post at the id',
+          evidence,
+        },
+      };
+    case RECONCILE_DECISION.UNCERTAIN:
+      return {
+        call: null,
+        note: 'reconciliation is uncertain (zero matches is not absence; a truncated list is not uniqueness); keep the reservation and re-check next run',
+        evidence,
+      };
+    default:
+      throw new BufferError(
+        'CONFIG',
+        `unknown reconcile decision ${JSON.stringify(recon.decision)}`
+      );
+  }
+}

+  it('HTTP 429 with no post id -> RATE_LIMITED, safeToRetry, RETRYABLE with an ISO retryAt', async () => {
+    const { c, fetchImpl } = client({
+      'mutation CreatePost': () =>
+        jsonResponse(
+          {
+            errors: [{ message: 'Too many requests', extensions: { code: 'RATE_LIMIT_EXCEEDED' } }],
+          },
+          429,
+          { 'retry-after': '30' }
+        ),
+    });
+    const out = await c.create({ post: post('facebook') });
+    expect(out.outcome).toBe(PUBLISH_OUTCOME.RATE_LIMITED);
+    expect(out.safeToRetry).toBe(true);
+    const mapped = toRecordResult(out, { now: () => NOW_MS });
+    expect(mapped.recordResult).toMatchObject({ status: 'RETRYABLE', safeToRetry: true });
+    expect(Number.isNaN(Date.parse(mapped.recordResult!.retryAt as string))).toBe(false);
+    // The adapter itself never loops.
+    expect(fetchImpl.createCalls()).toHaveLength(1);
+  });
+
+  it('a top-level RATE_LIMIT_EXCEEDED at HTTP 200 with no post id is also RATE_LIMITED', () => {
+    const out = classifyCreateResponse({
+      httpStatus: 200,
+      headers: {},
+      json: { errors: [{ message: 'slow down', extensions: { code: 'RATE_LIMIT_EXCEEDED' } }] },
+      retryAfterMs: null,
+      expectedChannelId: CH.facebook,
+    });
+    expect(out.outcome).toBe(PUBLISH_OUTCOME.RATE_LIMITED);
+    expect(out.safeToRetry).toBe(true);
+  });
+
+  it('a 5xx after a possible send is AMBIGUOUS and NOT safeToRetry', async () => {
+    const { c } = client({
+      'mutation CreatePost': () => jsonResponse({ errors: [{ message: 'oops' }] }, 503),
+    });
+    const out = await c.create({ post: post('facebook') });
+    expect(out.outcome).toBe(PUBLISH_OUTCOME.AMBIGUOUS);
+    expect(out.safeToRetry).toBe(false);

+/** Route a fake `fetch` for the single Buffer endpoint by the GraphQL document. */
+function bufferRouter(routes: Partial<Record<(typeof OPERATIONS)[number], Handler>>) {
+  const calls: GqlCall[] = [];
+  const fn = vi.fn(async (url: string, init: Init = {}) => {
+    const parsed = JSON.parse(String(init.body ?? '{}'));
+    const call: GqlCall = {
+      url,
+      method: init.method ?? 'GET',
+      headers: lower(init.headers),
+      query: String(parsed.query ?? ''),
+      variables: (parsed.variables ?? {}) as Record<string, unknown>,
+    };

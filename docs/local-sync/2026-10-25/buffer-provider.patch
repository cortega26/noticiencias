+    },
+    list(channelId: string) {
+      return [...posts.values()].filter((p) => p.channelId === channelId);
+    },
+    createHandler(
+      opts: {
+        /** if set, the fake stores the post then the response fails this way */
+        failAfterStore?: 'timeout' | 500;
+        status?: string;
+      } = {}
+    ): Handler {
+      return (call) => {
+        const v = call.variables;
+        const rec = this.add({
+          channelId: v.channelId,
+          text: v.text,
+          externalLink:
+            Array.isArray(v.assets) && v.assets.length > 0
+              ? (v.assets[0] as { link: { url: string } }).link.url
+              : null,
+          status: opts.status ?? 'scheduled',
+        });
+        if (opts.failAfterStore === 'timeout') {
+          const err = new Error('socket hang up');
+          err.name = 'TimeoutError';
+          return Promise.reject(err);
+        }
+        if (opts.failAfterStore === 500)
+          return jsonResponse({ errors: [{ message: 'boom' }] }, 500);
+        return jsonResponse({
+          data: {
+            createPost: {
+              __typename: 'PostActionSuccess',
+              post: {
+                id: rec.id,
+                status: rec.status,
+                channelId: rec.channelId,
+                text: rec.text,
+                externalLink: rec.externalLink,
+                sentAt: rec.sentAt,
+              },
+            },
+          },
+        });
+      };
+    },
+    listHandler(pageSize = 2): Handler {
+      return (call) => {
+        const channelId = String(call.variables.channelId);
+        const after = call.variables.after == null ? 0 : Number(call.variables.after);
+        const all = this.list(channelId);
+        const slice = all.slice(after, after + pageSize);
+        const nextIndex = after + pageSize;
+        const hasNextPage = nextIndex < all.length;
+        return jsonResponse({
+          data: {
+            posts: {
+              edges: slice.map((n) => ({
+                node: {
+                  id: n.id,
+                  status: n.status,
+                  channelId: n.channelId,
+                  text: n.text,
+                  externalLink: n.externalLink,
+                  sentAt: n.sentAt,
+                  createdAt: '2026-09-07T00:00:00.000Z',
+                },
+              })),
+              pageInfo: { hasNextPage, endCursor: hasNextPage ? String(nextIndex) : null },
+            },
+          },
+        });
+      };
+    },
+  };
+}

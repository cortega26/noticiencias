---
import ArticleCard from '~/components/ds/organisms/ArticleCard.astro';
import SectionHeading from '~/components/ds/molecules/SectionHeading.astro';
import TopicStrip from '~/components/common/TopicStrip.astro';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/date';
import { configuredCategorySections } from '~/utils/categorySections';
import type { RecentSelection, TopicFrequency } from '~/utils/hub';
import type { SeriesDossier } from '~/utils/series';
import type { Post } from '~/types';

interface Props {
  editionDate: Date;
  leadPosts: Post[];
  weekly: RecentSelection;
  archivePosts: Post[];
  featuredSeries: SeriesDossier | null;
  topicRadar: TopicFrequency[];
}

const { editionDate, leadPosts, weekly, archivePosts, featuredSeries, topicRadar } = Astro.props;
const [leadPost, ...secondaryLeadPosts] = leadPosts;
const editionLabel = getFormattedDate(editionDate, 'long');
const weeklyTitle = weekly.inWindow ? 'De esta edición' : 'Lo más reciente';
const weeklyDescription = weekly.inWindow
  ? 'Historias publicadas durante los siete días anteriores a la fecha de esta edición, con la fuente a un clic.'
  : 'Las historias más recientes del archivo, con la fuente a un clic.';
---

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:py-12">
  <header class="mb-8 border-b border-border-subtle pb-6">
    <p class="mb-3 text-sm text-text-muted">
      Portada · {editionLabel}
    </p>
    <h1
      class="max-w-4xl text-balance font-heading text-3xl font-bold leading-tight text-text-body sm:text-4xl lg:text-5xl"
    >
      Ciencia en español, con la evidencia a la vista.
    </h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-text-muted">
      Qué se encontró, cómo se sabe y qué sigue abierto. Explicaciones y noticias para leer la
      ciencia con criterio.
    </p>
    <a
      href="/metodologia/"
      class="mt-3 inline-block py-1 text-sm font-semibold text-primary underline underline-offset-4 hover:no-underline"
      >Cómo trabajamos con las fuentes</a
    >
  </header>

  {
    leadPost && (
      <section aria-label="Historia principal">
        <ArticleCard post={leadPost} variant="lead" />
        {secondaryLeadPosts.length > 0 && (
          <div class="mt-6 grid gap-6 md:grid-cols-2">
            {secondaryLeadPosts.map((post) => (
              <ArticleCard post={post} variant="compact" showTags={false} />
            ))}
          </div>
        )}
      </section>
    )
  }

  <section class="mt-10 border-y border-border-subtle py-7" aria-labelledby="home-guides">
    <h2 id="home-guides" class="font-heading text-2xl font-bold text-text-body">
      Entender antes de concluir
    </h2>
    <p class="mt-2 max-w-3xl text-base leading-relaxed text-text-muted">
      Dos guías para distinguir un hallazgo de lo que todavía falta demostrar.
    </p>
    <div class="mt-6 grid gap-6 md:grid-cols-2 md:gap-10">
      <article>
        <p class="text-sm text-text-muted">Clima y ecología</p>
        <h3 class="mt-2 text-balance font-heading text-2xl font-bold leading-snug text-text-body">
          <a
            href="/recursos/carbono-bosques-suelos/"
            class="hover:text-primary hover:underline underline-offset-4"
            >El carbono que entra al bosque no siempre se queda</a
          >
        </h3>
        <p class="mt-3 leading-relaxed text-text-muted">
          Qué distingue el flujo de carbono, las reservas y el almacenamiento duradero en bosques y
          suelos.
        </p>
      </article>
      <article>
        <p class="text-sm text-text-muted">Espacio</p>
        <h3 class="mt-2 text-balance font-heading text-2xl font-bold leading-snug text-text-body">
          <a
            href="/recursos/exoplanetas-atmosferas-biosignaturas/"
            class="hover:text-primary hover:underline underline-offset-4"
            >De detectar un planeta a buscar señales de vida</a
          >
        </h3>
        <p class="mt-3 leading-relaxed text-text-muted">
          Las pruebas que permiten hablar de un exoplaneta, su atmósfera y una posible biosignatura.
        </p>
      </article>
    </div>
  </section>

  {
    weekly.posts.length > 0 && (
      <section class="mt-12">
        <SectionHeading
          title={weeklyTitle}
          description={weeklyDescription}
          href="/blog/"
          linkText="Archivo completo"
        />
        <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {weekly.posts.map((post) => (
            <ArticleCard post={post} variant="standard" showTags={false} />
          ))}
        </div>
      </section>
    )
  }

  {
    featuredSeries && (
      <section class="mt-12">
        <SectionHeading
          title="Serie destacada"
          description="Una colección para leer un hilo completo, del primer artículo al último."
        />
        <div class="mt-6 flex flex-col gap-4 border-y border-border-subtle py-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h3 class="font-heading text-2xl font-bold text-text-body">{featuredSeries.name}</h3>
            <p class="mt-1 max-w-2xl text-sm leading-relaxed text-text-muted">
              {featuredSeries.description}
            </p>
            <p class="mt-1 text-sm text-text-muted">
              {`${featuredSeries.count} ${featuredSeries.count === 1 ? 'artículo' : 'artículos'}`} ·
              Actualizada el {getFormattedDate(featuredSeries.latestDate, 'long')}
            </p>
          </div>
          <a
            href={getPermalink(`/series/${featuredSeries.slug}`, 'page')}
            data-analytics-series={featuredSeries.slug}
            class="shrink-0 text-sm font-semibold text-primary underline-offset-4 hover:underline"
          >
            Ver la serie →
          </a>
        </div>
      </section>
    )
  }

  {
    archivePosts.length > 0 && (
      <section class="mt-12">
        <SectionHeading
          title="Del archivo"
          description="Piezas del archivo, elegidas para volver a leerlas."
        />
        <div class="mt-6 grid gap-5">
          {archivePosts.map((post) => (
            <ArticleCard post={post} variant="row" showExcerpt={false} showTags={false} />
          ))}
        </div>
      </section>
    )
  }

  <TopicStrip
    topics={topicRadar}
    showCounts
    title="Temas de la edición"
    class="mt-10"
    description="Los temas que más se repiten en la edición reciente."
  />

  <nav aria-label="Secciones" class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm">
    {
      configuredCategorySections.map(({ title, slug }) => (
        <a
          href={getPermalink(slug, 'category')}
          data-analytics-category={slug}
          class="font-semibold text-text-muted hover:text-primary"
        >
          {title}
        </a>
      ))
    }
  </nav>

  <section class="mt-12 border-t border-border-subtle pt-8">
    <SectionHeading
      title="Para leer con criterio"
      description="Preguntas para evaluar una noticia, nuestro método y el archivo completo."
    />
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      <a
        href="/recursos/detector-de-hype/"
        class="border-t border-border-subtle pt-4 text-text-body hover:text-primary"
      >
        <h3 class="font-heading text-xl font-bold">Detector de hype</h3>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">
          Una guía breve para leer promesas científicas con mejores preguntas.
        </p>
      </a>
      <a
        href="/metodologia/"
        class="border-t border-border-subtle pt-4 text-text-body hover:text-primary"
      >
        <h3 class="font-heading text-xl font-bold">Cómo trabajamos</h3>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">
          El recorrido editorial desde la fuente original hasta la publicación.
        </p>
      </a>
      <a
        href="/buscar/"
        class="border-t border-border-subtle pt-4 text-text-body hover:text-primary"
      >
        <h3 class="font-heading text-xl font-bold">Buscar en el archivo</h3>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">
          Encuentra temas, categorías y fuentes ya publicadas por Noticiencias.
        </p>
      </a>
    </div>
  </section>
</div>

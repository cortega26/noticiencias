---
import ArticleCard from '~/components/ds/organisms/ArticleCard.astro';
import SectionHeading from '~/components/ds/molecules/SectionHeading.astro';
import Button from '~/components/ds/atoms/Button.astro';
import NewsletterCapture from '~/components/common/NewsletterCapture.astro';
import TopicStrip from '~/components/common/TopicStrip.astro';
import { cleanSlug, getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/date';
import { configuredCategorySections } from '~/utils/categorySections';
import type { FeaturedSeries, RecentSelection, TopicFrequency } from '~/utils/hub';
import type { Post } from '~/types';

interface Props {
  editionDate: Date;
  leadPosts: Post[];
  weekly: RecentSelection;
  archivePosts: Post[];
  featuredSeries: FeaturedSeries | null;
  topicRadar: TopicFrequency[];
}

const { editionDate, leadPosts, weekly, archivePosts, featuredSeries, topicRadar } = Astro.props;
const [leadPost, ...secondaryLeadPosts] = leadPosts;
const editionLabel = getFormattedDate(editionDate, 'long');
const weeklyTitle = weekly.inWindow ? 'Esta semana' : 'Lo más reciente';
const weeklyDescription = weekly.inWindow
  ? 'Lo publicado en los últimos siete días, con la fuente a un clic.'
  : 'Las historias más recientes del archivo, con la fuente a un clic.';
---

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:py-12">
  <header class="mb-8 pb-6 border-b border-border-subtle/50 relative">
    <p class="mb-2 text-xs font-bold text-primary uppercase tracking-wider">
      Portada · {editionLabel}
    </p>
    <h1 class="max-w-5xl font-heading text-4xl font-black leading-none text-text-body md:text-6xl">
      La ciencia que conviene seguir esta semana.
    </h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-text-muted">
      Una edición en español para entrar rápido en los hallazgos, las dudas y las consecuencias de
      cada historia.
    </p>
    <div
      class="absolute bottom-0 left-0 w-32 h-[3px] bg-gradient-to-r from-primary to-accent rounded-full"
    >
    </div>
  </header>

  {
    leadPost && (
      <section aria-label="Historia principal">
        <ArticleCard post={leadPost} variant="lead" />
        {secondaryLeadPosts.length > 0 && (
          <div class="mt-6 grid gap-6 md:grid-cols-2">
            {secondaryLeadPosts.map((post) => (
              <ArticleCard post={post} variant="compact" showTags={false} />
            ))}
          </div>
        )}
      </section>
    )
  }

  <section
    class="mt-8 rounded-xl border border-border-subtle bg-surface-paper px-5 py-6 sm:px-8"
    aria-labelledby="home-newsletter-cta"
  >
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2
          id="home-newsletter-cta"
          class="font-heading text-xl font-bold leading-tight text-text-body sm:text-2xl"
        >
          El resumen semanal, en tu correo
        </h2>
        <p class="mt-1 max-w-2xl text-sm leading-relaxed text-text-muted">
          Una edición por semana con los hallazgos que valió la pena leer dos veces.
        </p>
      </div>
      <Button
        variant="primary"
        href="/newsletter/"
        text="Suscribirme"
        class="shrink-0 self-start sm:self-auto"
      />
    </div>
  </section>

  {
    weekly.posts.length > 0 && (
      <section class="mt-12">
        <SectionHeading
          title={weeklyTitle}
          description={weeklyDescription}
          href="/blog/"
          linkText="Archivo completo"
        />
        <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {weekly.posts.map((post) => (
            <ArticleCard post={post} variant="standard" showTags={false} />
          ))}
        </div>
      </section>
    )
  }

  {
    featuredSeries && (
      <section class="mt-12">
        <SectionHeading
          title="Serie destacada"
          description="Una colección para seguir un hilo completo, del primer artículo al último."
        />
        <div class="mt-6 flex flex-col gap-4 rounded-xl border border-border-subtle bg-surface-paper p-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h3 class="font-heading text-2xl font-bold text-text-body">{featuredSeries.name}</h3>
            <p class="mt-1 text-sm text-text-muted">
              {`${featuredSeries.count} ${featuredSeries.count === 1 ? 'artículo' : 'artículos'}`} ·
              Actualizada el {getFormattedDate(featuredSeries.latestDate, 'long')}
            </p>
          </div>
          <a
            href={getPermalink(`/series/${cleanSlug(featuredSeries.name)}`, 'page')}
            class="shrink-0 text-sm font-semibold text-primary underline-offset-4 hover:underline"
          >
            Ver la serie →
          </a>
        </div>
      </section>
    )
  }

  {
    archivePosts.length > 0 && (
      <section class="mt-12">
        <SectionHeading
          title="Del archivo"
          description="Piezas que ya salieron de la edición semanal, elegidas para volver a leerlas."
        />
        <div class="mt-6 grid gap-5">
          {archivePosts.map((post) => (
            <ArticleCard post={post} variant="row" showExcerpt={false} showTags={false} />
          ))}
        </div>
      </section>
    )
  }

  <TopicStrip
    topics={topicRadar}
    showCounts
    class="mt-10"
    description="Los temas que más se repiten en la edición reciente."
  />

  <nav aria-label="Secciones" class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm">
    {
      configuredCategorySections.map(({ title, slug }) => (
        <a
          href={getPermalink(slug, 'category')}
          class="font-semibold text-text-muted hover:text-primary"
        >
          {title}
        </a>
      ))
    }
  </nav>

  <section class="mt-14 rounded-xl border border-border-subtle/50 bg-surface-highlight p-6 sm:p-8">
    <SectionHeading
      title="Para leer con criterio"
      description="Piezas para volver cuando una noticia científica llega demasiado vestida de promesa."
    />
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      <a
        href="/recursos/detector-de-hype/"
        class="border-t border-border-subtle pt-4 text-text-body hover:text-primary"
      >
        <h3 class="font-heading text-xl font-bold">Detector de hype</h3>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">
          Una guía breve para leer promesas científicas con mejores preguntas.
        </p>
      </a>
      <a
        href="/metodologia/"
        class="border-t border-border-subtle pt-4 text-text-body hover:text-primary"
      >
        <h3 class="font-heading text-xl font-bold">Cómo trabajamos</h3>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">
          El recorrido editorial desde la fuente original hasta la publicación.
        </p>
      </a>
      <a
        href="/buscar/"
        class="border-t border-border-subtle pt-4 text-text-body hover:text-primary"
      >
        <h3 class="font-heading text-xl font-bold">Buscar en el archivo</h3>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">
          Encuentra temas, categorías y fuentes ya publicadas por Noticiencias.
        </p>
      </a>
    </div>
  </section>
</div>

<NewsletterCapture
  title="Boletín Noticiencias"
  description="Una edición semanal con hallazgos, fuentes y temas para guardar."
  class="mt-4"
/>

---
import { APP_CONFIG } from 'astrowind:config';
import { getAsset } from '~/utils/permalinks';
import Button from '~/components/ds/atoms/Button.astro';

interface Props {
  title?: string;
  description?: string;
  class?: string;
  /** Unique id prefix so several captures can coexist on the same page. */
  formId?: string;
  /** `full` = section with heading + form; `inline` = bare form for a band. */
  variant?: 'full' | 'inline';
}

const {
  title = 'Boletín Noticiencias',
  description = 'Una edición semanal con hallazgos, fuentes y temas para guardar.',
  class: className = '',
  formId = 'newsletter',
  variant = 'full',
} = Astro.props;

const endpoint = APP_CONFIG?.form?.newsletter_endpoint || '';
const isEnabled = endpoint.length > 0;
const emailId = `${formId}-email`;
const statusId = `${formId}-status`;
const microcopy =
  variant === 'full'
    ? 'Una entrega semanal. Baja inmediata desde cada correo.'
    : 'Una entrega semanal. Baja inmediata.';

const Tag = variant === 'full' ? 'section' : 'div';
const wrapperClass =
  variant === 'full'
    ? `rounded-xl border border-border-subtle bg-surface-paper px-6 py-10 sm:px-8 shadow-sm hover:shadow-md transition-all duration-300 ${className}`
    : className;
const innerClass =
  variant === 'full' ? 'mx-auto grid max-w-6xl gap-6 md:grid-cols-[1fr_420px] md:items-center' : '';
const formClass = 'grid w-full gap-3 sm:grid-cols-[1fr_auto]';
---

<Tag class={wrapperClass}>
  <div class={innerClass}>
    {
      variant === 'full' && (
        <div>
          <h2 class="font-heading text-3xl font-bold leading-tight text-text-body">{title}</h2>
          <p class="mt-3 max-w-2xl text-base leading-relaxed text-text-muted">{description}</p>
        </div>
      )
    }

    {
      isEnabled ? (
        <form
          action={endpoint}
          method="post"
          class={formClass}
          aria-label="Suscripción al boletín"
          data-analytics-newsletter
          data-newsletter-form
        >
          <label class="sr-only" for={emailId}>
            Correo electrónico
          </label>
          <input
            id={emailId}
            type="email"
            name="email"
            autocomplete="email"
            placeholder="tu@email.com"
            required
            class="min-h-11 rounded-md border border-border-subtle bg-white px-4 text-base text-text-body outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-200 dark:bg-slate-950"
          />
          <Button variant="primary" type="submit" text="Suscribirme" data-newsletter-submit />
          <p
            id={statusId}
            role="status"
            aria-live="polite"
            data-newsletter-status
            class="min-h-5 text-xs text-text-muted sm:col-span-2"
          >
            {microcopy}
          </p>
        </form>
      ) : (
        <div class="flex flex-wrap gap-3">
          <a
            href={getAsset('/rss.xml')}
            class="rounded-md border border-border-subtle px-4 py-2.5 text-sm font-semibold text-text-body hover:border-primary hover:text-primary transition-colors duration-200"
          >
            RSS
          </a>
          <a
            href="/blog/"
            class="rounded-md border border-border-subtle px-4 py-2.5 text-sm font-semibold text-text-body hover:border-primary hover:text-primary transition-colors duration-200"
          >
            Ver archivo
          </a>
        </div>
      )
    }
  </div>
</Tag>

<script>
  // Progressive enhancement over the no-JS Buttondown POST (ADR-0009):
  // the native form stays the fallback, this only adds accessible
  // loading/success/error states. Bound once via delegation so Astro page
  // transitions (ClientRouter) and multiple captures keep working.
  function bindNewsletterForms() {
    if (document.documentElement.dataset.newsletterFormsBound === 'true') return;
    document.documentElement.dataset.newsletterFormsBound = 'true';

    document.addEventListener('submit', async (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !form.matches('[data-newsletter-form]')) return;

      const state = form.dataset.newsletterState;
      if (state === 'loading' || state === 'success') {
        event.preventDefault();
        return;
      }

      event.preventDefault();
      const status = form.querySelector('[data-newsletter-status]');
      const submit = form.querySelector('[data-newsletter-submit]');
      form.dataset.newsletterState = 'loading';
      form.setAttribute('aria-busy', 'true');
      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      if (status) status.textContent = 'Enviando…';

      try {
        // `redirect: manual` keeps Buttondown's confirmation redirect opaque:
        // the opaque response means the subscription request was accepted.
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          redirect: 'manual',
        });
        if (response.type !== 'opaqueredirect' && !response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }
        form.dataset.newsletterState = 'success';
        form.removeAttribute('aria-busy');
        if (status) status.textContent = 'Revisa tu correo para confirmar tu suscripción.';
      } catch {
        form.dataset.newsletterState = 'error';
        form.removeAttribute('aria-busy');
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
        if (status) status.textContent = 'No pudimos completar la suscripción. Inténtalo de nuevo.';
      }
    });
  }

  bindNewsletterForms();
  document.addEventListener('astro:page-load', bindNewsletterForms);
</script>

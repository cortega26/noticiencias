---
import ArticleCard from '~/components/ds/organisms/ArticleCard.astro';
import SectionHeading from '~/components/ds/molecules/SectionHeading.astro';
import type { RelatedSelection } from '~/utils/related';

interface Props {
  selection: RelatedSelection;
}

const { selection } = Astro.props;
const isRelated = selection.kind === 'related';
const title = isRelated ? 'Relacionado' : 'Más reciente';
const description = isRelated
  ? 'Historias conectadas por tema, serie o método.'
  : 'Historias recientes de Noticiencias.';
---

{
  selection.posts.length > 0 && (
    <section class="mt-14 border-t border-border-subtle pt-8">
      {/*
        P2-01: ranking con umbral (categoría, tags, serie, método). Si nada
        supera el umbral, el bloque se rotula «Más reciente», nunca
        «Relacionado» (DEC-008/P0-08).
      */}
      <SectionHeading title={title} description={description} />
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {selection.posts.map((post) => (
          <ArticleCard post={post} variant="compact" />
        ))}
      </div>
    </section>
  )
}

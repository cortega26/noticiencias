---
import TopicStrip from '~/components/common/TopicStrip.astro';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/date';
import type { TopicFrequency } from '~/utils/hub';
import type { Taxonomy } from '~/types';

interface Props {
  title: string;
  total: number;
  description?: string;
  updatedAt?: Date;
  areas?: Taxonomy[];
  series?: { name: string; slug: string }[];
  relatedTopics?: TopicFrequency[];
}

const {
  title,
  total,
  description,
  updatedAt,
  areas = [],
  series = [],
  relatedTopics = [],
} = Astro.props;

const fallbackDescription = `${total} ${total === 1 ? 'historia publicada' : 'historias publicadas'} sobre este hilo de ciencia y tecnología.`;
---

<header class="mb-8 border-b border-border-subtle pb-5">
  <p class="mb-2 text-sm font-semibold text-primary">Tema</p>
  <h1 class="font-heading text-4xl font-black leading-tight text-text-body md:text-5xl">{title}</h1>
  <p class="mt-3 max-w-3xl text-lg leading-relaxed text-text-muted">
    {description ?? fallbackDescription}
  </p>
  {
    updatedAt && (
      <p class="mt-3 text-sm text-text-muted">
        {`${total} ${total === 1 ? 'historia' : 'historias'}`} · Actualizada el{' '}
        {getFormattedDate(updatedAt, 'long')}
      </p>
    )
  }
  {
    areas.length > 0 && (
      <nav aria-label="Áreas del tema" class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {areas.map((area) => (
          <a
            href={getPermalink(area.slug, 'category')}
            class="font-semibold text-text-muted hover:text-primary"
          >
            {area.title}
          </a>
        ))}
      </nav>
    )
  }
  {
    series.length > 0 && (
      <p class="mt-3 text-sm text-text-muted">
        Series:{' '}
        {series.map((item, index) => (
          <>
            {index > 0 && ' · '}
            <a
              href={getPermalink(`/series/${item.slug}`, 'page')}
              class="font-semibold text-primary underline-offset-4 hover:underline"
            >
              {item.name}
            </a>
          </>
        ))}
      </p>
    )
  }
  {
    relatedTopics.length > 0 && (
      <TopicStrip
        topics={relatedTopics}
        title="Temas relacionados"
        description="Temas que aparecen cerca de este hilo."
        class="mt-5"
      />
    )
  }
</header>

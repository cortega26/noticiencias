---
import type { Post } from '~/types';

type RailSection = 'summary' | 'glossary' | 'sources';

interface Props {
  post: Post;
  sections?: RailSection[];
  variant?: 'rail' | 'inline';
  class?: string;
}

const { post, sections, variant = 'rail', class: className = '' } = Astro.props;

const activeSections = sections ?? (['summary', 'glossary', 'sources'] as RailSection[]);

const summaryPoints = post.summary_points?.length
  ? post.summary_points
  : post.excerpt
    ? [post.excerpt]
    : [];

const glossary = post.glossary ?? [];

const sourceFallback =
  post.sources?.length || !post.source_url
    ? post.sources
    : [
        {
          title: post.refinery_id || 'Fuente original',
          url: post.source_url,
        },
      ];

const isRail = variant === 'rail';
const Wrapper = isRail ? 'aside' : 'div';
const headingClass = isRail
  ? 'font-heading text-lg font-bold text-text-body'
  : 'font-heading text-xl font-bold text-text-body';
---

<Wrapper class:list={[className, isRail ? 'space-y-5' : '']}>
  {
    activeSections.includes('summary') && summaryPoints.length > 0 && (
      <section class="rounded-md border border-border-subtle bg-surface-paper p-5">
        <h2 class={headingClass}>En breve</h2>
        <ul class="mt-3 grid gap-2 text-text-muted">
          {summaryPoints.map((point) => (
            <li class="pl-4 [text-indent:-1rem]">
              <span class="font-bold text-primary">•</span> {point}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    activeSections.includes('glossary') && glossary.length > 0 && (
      <section class="rounded-md border border-border-subtle p-5">
        <h2 class={headingClass}>Glosario</h2>
        <dl class="mt-4 grid gap-4">
          {glossary.map((entry) => (
            <div>
              <dt class="font-semibold text-text-body">{entry.term}</dt>
              <dd class="mt-1 text-sm leading-relaxed text-text-muted">{entry.definition}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  {
    activeSections.includes('sources') && sourceFallback && sourceFallback.length > 0 && (
      <section class="rounded-md border border-border-subtle p-5">
        <h2 class={headingClass}>Fuentes</h2>
        <ul class="mt-3 grid gap-2">
          {sourceFallback.map((source) => (
            <li>
              <a
                href={source.url}
                class="text-sm font-medium text-primary underline-offset-4 hover:underline"
              >
                {source.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Wrapper>

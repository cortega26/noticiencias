---
import { getCategoryColors } from '~/utils/categorySections';

interface Props {
  topic: string;
  href?: string;
  slug?: string;
  size?: 'sm' | 'md';
  class?: string;
  [key: string]: any;
}

const { topic, href, slug, size = 'md', class: className = '', ...rest } = Astro.props;

const baseStyles = 'inline-flex items-center font-bold rounded-sm transition-colors';

const sizes = {
  sm: 'text-[10px] px-1.5 py-0.5',
  md: 'text-xs px-2 py-1',
};

// Colores cerrados por slug de categoría (src/utils/categorySections.ts).
// Un slug de categoría que falte en el mapa es un error de contenido: el
// build debe fallar para que se corrija el mapa o el dato, no renderizar
// un badge genérico indiferenciable.
const categoryColors = slug ? getCategoryColors(slug) : null;
if (slug && !categoryColors) {
  throw new Error(
    `TopicBadge: la categoría "${slug}" no está mapeada en configuredCategorySections (categorySections.ts). Agrega su color antes de renderizar.`
  );
}

const colors =
  categoryColors ??
  'bg-surface-highlight text-primary hover:bg-slate-100 dark:hover:bg-slate-700 border border-transparent';
---

{
  href ? (
    <a href={href} class:list={[baseStyles, sizes[size], colors, className]} {...rest}>
      {topic}
    </a>
  ) : (
    <span class:list={[baseStyles, sizes[size], colors, className]} {...rest}>
      {topic}
    </span>
  )
}

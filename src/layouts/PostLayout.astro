---
import Image from '~/components/common/Image.astro';
import RelatedReading from '~/components/common/RelatedReading.astro';
import TopicStrip from '~/components/common/TopicStrip.astro';
import TrustPanel from '~/components/common/TrustPanel.astro';
import TopicBadge from '~/components/ds/atoms/TopicBadge.astro';
import InvestigationBadge from '~/components/ds/atoms/InvestigationBadge.astro';
import ArticleRail from '~/components/ds/molecules/ArticleRail.astro';
import SourceLine from '~/components/ds/molecules/SourceLine.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/ds/molecules/Breadcrumbs.astro';
import SocialShare from '~/components/template/common/SocialShare.astro';
import { findImage } from '~/utils/images';
import { getCanonical, getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/date';
import { serializeJsonLd } from '~/utils/json-ld';
import { resolveSourcePublisher, resolveSourceTitle } from '~/utils/source-publisher';
import { evidenceLabels, publicationChipLabels } from '~/utils/evidence-labels';
import type { MetaData, Post } from '~/types';

interface Props {
  post: Post;
  relatedPosts?: Post[];
  url: string | URL;
}

const { post, relatedPosts = [], url } = Astro.props;
const image = (await findImage(post.image)) ?? post.image;
const imageSrc = typeof post.image === 'string' ? post.image : post.image?.src;
const imageAlt = post.image_alt ?? '';
const displayAuthor = /noticiencias\s+ai/i.test(post.author ?? '')
  ? 'Equipo Noticiencias'
  : post.author || 'Noticiencias';
const isNoticienciasAi = /noticiencias\s+ai/i.test(post.author ?? '');
const sourcePublisher = resolveSourcePublisher(post);
const articleTopics = (post.tags ?? []).map((tag) => ({
  slug: tag.slug,
  title: tag.title,
  count: 1,
}));
const sourceFallback =
  post.sources?.length || !post.source_url
    ? post.sources
    : [
        {
          title: resolveSourceTitle(post),
          url: post.source_url,
        },
      ];

// P1-04: methodology chips (max 3). Unknown/other carry no information and
// are omitted; legacy posts without evidence data render no chips.
const evidenceChips: string[] = [
  ...(post.evidence_subject_type && post.evidence_subject_type !== 'unknown'
    ? [`Modelo: ${evidenceLabels[post.evidence_subject_type]}`]
    : []),
  ...(post.publication_status && post.publication_status !== 'other'
    ? [publicationChipLabels[post.publication_status]]
    : []),
  ...(sourceFallback?.some((source) => source.role === 'primary') ? ['Fuente primaria'] : []),
].slice(0, 3);

const canonical = String(getCanonical(typeof url === 'string' ? url : url.pathname));

const metadata: MetaData = {
  title: post.title,
  description: post.excerpt,
  canonical,
  openGraph: {
    type: 'article',
    images: imageSrc ? [{ url: imageSrc }] : [],
    'article:published_time': post.publishDate.toISOString(),
    'article:modified_time': (post.updateDate ?? post.publishDate).toISOString(),
    'article:section': post.category?.title,
  },
};
const publisherOrg = {
  '@type': 'Organization',
  name: 'Noticiencias',
  url: 'https://noticiencias.com/',
  logo: {
    '@type': 'ImageObject',
    url: 'https://noticiencias.com/assets/images/default.png',
    width: 1200,
    height: 628,
  },
};

const wordCount = post.content ? post.content.split(/\s+/).filter(Boolean).length : undefined;

const schema = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.title.substring(0, 110),
  description: post.excerpt,
  image: imageSrc ? [imageSrc] : [],
  datePublished: post.publishDate.toISOString(),
  dateModified: (post.updateDate ?? post.publishDate).toISOString(),
  articleSection: post.category?.title,
  author: [
    {
      '@type': 'Organization',
      name: displayAuthor,
      url: 'https://noticiencias.com/nosotros/',
    },
  ],
  publisher: publisherOrg,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  inLanguage: 'es',
  isAccessibleForFree: true,
  ...(wordCount ? { wordCount } : {}),
});

const breadcrumbItems = [
  { label: 'Inicio', href: 'https://noticiencias.com/' },
  ...(post.category
    ? [
        {
          label: post.category.title,
          href: getPermalink(post.category.slug, 'category'),
        },
      ]
    : []),
  { label: post.title, href: canonical },
];
---

<BaseLayout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={schema} />

  <Breadcrumbs items={breadcrumbItems} />

  <article class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
    <header class="mx-auto max-w-5xl border-b border-border-subtle pb-8">
      <div class="mb-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-text-muted">
        {post.investigation && <InvestigationBadge size="sm" />}
        {
          post.category && (
            <TopicBadge
              topic={post.category.title}
              slug={post.category.slug}
              href={getPermalink(post.category.slug, 'category')}
            />
          )
        }
        <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
        {post.readingTime && <span>{post.readingTime} min lectura</span>}
      </div>

      <h1
        class:list={[
          'text-4xl font-black leading-tight text-text-body md:text-6xl',
          post.investigation ? 'font-serif' : 'font-heading',
        ]}
      >
        {post.title}
      </h1>

      <SourceLine post={post} size="sm" class="mt-5" />

      {post.excerpt && <p class="mt-5 text-xl leading-relaxed text-text-muted">{post.excerpt}</p>}

      {
        evidenceChips.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="Datos metodológicos">
            {evidenceChips.map((chip) => (
              <li>
                <TopicBadge topic={chip} size="sm" />
              </li>
            ))}
          </ul>
        )
      }

      {
        (!sourcePublisher || !isNoticienciasAi) && (
          <p class="mt-6 text-sm font-medium text-text-muted">
            Por{' '}
            <a href="/nosotros/" class="text-text-body underline-offset-4 hover:underline">
              {displayAuthor}
            </a>
          </p>
        )
      }

      {
        image && (
          <figure class="mt-8">
            <div class="overflow-hidden rounded-md bg-surface-highlight">
              <Image
                src={image}
                alt={imageAlt}
                width={1280}
                height={720}
                widths={[480, 900, 1280, 1600]}
                sizes="(max-width: 1024px) 100vw, 1100px"
                class="aspect-[16/9] w-full object-cover"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <figcaption class="mt-2 text-sm text-text-muted">{imageAlt}</figcaption>
          </figure>
        )
      }
    </header>

    <div class="mx-auto mt-6 flex max-w-5xl justify-end">
      <SocialShare text={post.title} url={canonical} />
    </div>

    {
      // P1-05: "Qué cambia" is optional prose (1-3 short paragraphs from
      // why_it_matters, 0-3 items per P0-06). The block vanishes when empty.
      // Name follows DEC-018 (repo voice guardrail).
      post.why_it_matters && post.why_it_matters.length > 0 && (
        <section class="not-prose mx-auto mt-10 max-w-6xl border-l-4 border-primary bg-surface-paper p-5">
          <h2 class="font-heading text-xl font-bold text-text-body">Qué cambia</h2>
          {post.why_it_matters.map((item) => (
            <p class="mt-3 leading-relaxed text-text-muted">{item}</p>
          ))}
        </section>
      )
    }

    <div class="mx-auto mt-10 grid max-w-6xl gap-10 lg:grid-cols-[minmax(0,1fr)_280px]">
      <div class="min-w-0">
        <ArticleRail post={post} variant="inline" sections={['summary']} class="mb-8 lg:hidden" />

        <div
          data-analytics-scroll
          class="prose prose-lg prose-serif max-w-none dark:prose-invert prose-headings:font-heading prose-headings:font-bold prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-md prose-li:my-0"
        >
          <slot />
        </div>

        <ArticleRail post={post} variant="inline" sections={['glossary']} class="mt-10 lg:hidden" />

        <TrustPanel
          confidence={post.confidence}
          factCheck={post.fact_check}
          sources={sourceFallback}
          uncertaintyNote={post.uncertainty_note}
          requiresUncertaintyNote={post.requires_uncertainty_note}
          translationMethod={post.translation_method}
          reviewStatus={post.review_status}
          evidenceSubjectType={post.evidence_subject_type}
          evidenceDetail={post.evidence_detail}
          isHealthCategory={post.category?.slug === 'salud'}
          institution={post.institution}
          publicationStatus={post.publication_status}
          reviewerName={post.reviewer_name}
          reviewerRole={post.reviewer_role}
          reviewerProfileUrl={post.reviewer_profile_url}
          reviewDate={post.review_date}
          knownPoints={post.known_points}
          openQuestions={post.open_questions}
          correctedAt={post.corrected_at}
          correctionSummary={post.correction_summary}
          isAiAssisted={isNoticienciasAi}
        />

        <TopicStrip
          topics={articleTopics}
          title="Seguir temas"
          description="Más historias conectadas con esta lectura."
          class="not-prose mt-8"
        />

        <RelatedReading posts={relatedPosts} />
      </div>

      {
        /*
        Sources render only in TrustPanel (richer links + analytics hooks).
        Keeping 'sources' out of the rail avoids rendering the same source
        links twice in every viewport (P0-07).
      */
      }
      <ArticleRail
        post={post}
        sections={['summary', 'glossary']}
        class="hidden lg:block lg:sticky lg:top-20 self-start"
      />
    </div>
  </article>
</BaseLayout>

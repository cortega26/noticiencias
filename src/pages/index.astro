---
import BaseLayout from '~/layouts/BaseLayout.astro';
import DailyDesk from '~/components/common/DailyDesk.astro';
import { fetchPosts } from '~/utils/blog';
import {
  getEditionDate,
  getRecurringTopics,
  selectArchivePosts,
  selectFeaturedPosts,
  selectEditionPosts,
} from '~/utils/hub';
import { buildSeriesDossiers } from '~/utils/series';

const allPosts = await fetchPosts();
const editionDate = getEditionDate(allPosts);
const leadPosts = selectFeaturedPosts(allPosts, 3);
const leadPostIds = leadPosts.map((post) => post.id);
const editionPosts = selectEditionPosts(allPosts, { excludeIds: leadPostIds });
const editionPostIds = editionPosts.map((post) => post.id);
const archivePosts = selectArchivePosts(allPosts, {
  count: 3,
  excludeIds: [...leadPostIds, ...editionPostIds],
});
const featuredSeries = buildSeriesDossiers(allPosts)[0] ?? null;
const topicRadar = getRecurringTopics(allPosts);

const metadata = {
  title: 'Noticiencias - Portada científica en español.',
  description:
    'Una selección editorial de ciencia y tecnología en español, con fuentes y contexto para entender qué cambia.',
  ignoreTitleTemplate: true,
};
---

<BaseLayout metadata={metadata}>
  <DailyDesk
    editionDate={editionDate}
    leadPosts={leadPosts}
    editionPosts={editionPosts}
    archivePosts={archivePosts}
    featuredSeries={featuredSeries}
    topicRadar={topicRadar}
  />
</BaseLayout>

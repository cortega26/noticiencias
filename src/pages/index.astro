---
import BaseLayout from '~/layouts/BaseLayout.astro';
import DailyDesk from '~/components/common/DailyDesk.astro';
import { fetchPosts } from '~/utils/blog';
import {
  getEditionDate,
  getTopicFrequency,
  selectArchivePosts,
  selectFeaturedPosts,
  selectRecentPosts,
} from '~/utils/hub';
import { buildSeriesDossiers } from '~/utils/series';

const allPosts = await fetchPosts();
const editionDate = getEditionDate(allPosts);
const leadPosts = selectFeaturedPosts(allPosts, 3);
const leadPostIds = leadPosts.map((post) => post.id);
const weekly = selectRecentPosts(allPosts, editionDate, { count: 6, excludeIds: leadPostIds });
const weeklyPostIds = weekly.posts.map((post) => post.id);
const archivePosts = selectArchivePosts(allPosts, {
  count: 3,
  excludeIds: [...leadPostIds, ...weeklyPostIds],
});
const featuredSeries = buildSeriesDossiers(allPosts)[0] ?? null;
const topicRadar = getTopicFrequency(allPosts.slice(0, 18));

const metadata = {
  title: 'Noticiencias - Portada científica en español.',
  description:
    'Una selección semanal de ciencia y tecnología en español, con fuente primaria y contexto para entender qué cambia.',
  ignoreTitleTemplate: true,
};
---

<BaseLayout metadata={metadata}>
  <DailyDesk
    editionDate={editionDate}
    leadPosts={leadPosts}
    weekly={weekly}
    archivePosts={archivePosts}
    featuredSeries={featuredSeries}
    topicRadar={topicRadar}
  />
</BaseLayout>

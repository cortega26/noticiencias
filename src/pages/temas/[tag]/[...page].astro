---
import { fetchPosts, getStaticPathsBlogTag } from '~/utils/blog';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ArticleCard from '~/components/ds/organisms/ArticleCard.astro';
import Pagination from '~/components/common/Pagination.astro';
import TopicHubHeader from '~/components/common/TopicHubHeader.astro';
import { getRelatedTopics } from '~/utils/hub';
import { getTopicHub, MIN_TOPIC_HUB_POSTS } from '~/utils/topics';
import { cleanSlug } from '~/utils/permalinks';
import type { Taxonomy } from '~/types';

export const getStaticPaths = getStaticPathsBlogTag;

const { page, tag } = Astro.props;
const allPosts = await fetchPosts();
const relatedTopics = getRelatedTopics(allPosts, tag?.slug || '', 8);

const tagPosts = tag
  ? allPosts.filter((post) => post.tags?.some((item) => item.slug === tag.slug))
  : [];
const hub = tag ? getTopicHub(tag.slug) : undefined;
const isHub = Boolean(hub) && tagPosts.length >= MIN_TOPIC_HUB_POSTS;

const updatedAt = isHub
  ? tagPosts.reduce(
      (latest, post) => (post.publishDate.valueOf() > latest.valueOf() ? post.publishDate : latest),
      tagPosts[0].publishDate
    )
  : undefined;

const areaMap = new Map<string, Taxonomy>();
const seriesMap = new Map<string, { name: string; slug: string }>();
if (isHub) {
  for (const post of tagPosts) {
    if (post.category) areaMap.set(post.category.slug, post.category);
    if (post.series) {
      const slug = cleanSlug(post.series);
      seriesMap.set(slug, { name: post.series, slug });
    }
  }
}
const areas = [...areaMap.values()];
const series = [...seriesMap.values()];

const metadata = {
  title: `Etiqueta: ${tag?.title || ''}`,
  description: isHub
    ? hub?.description
    : `Artículos, contexto y temas relacionados sobre ${tag?.title || 'este tema'} en Noticiencias.`,
  robots: {
    index: false, // As per config.yaml: tag pages stay out of the index and the sitemap
    follow: true,
  },
};
---

<BaseLayout metadata={metadata}>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
    <TopicHubHeader
      title={tag?.title || 'Tema'}
      total={page.total}
      description={isHub ? hub?.description : undefined}
      updatedAt={updatedAt}
      areas={areas}
      series={series}
      relatedTopics={relatedTopics}
    />

    <div class="grid gap-6">
      {page.data.map((post) => <ArticleCard post={post} variant="row" />)}
    </div>

    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
</BaseLayout>

---
import Layout from '~/layouts/BaseLayout.astro';
import { getAsset } from '~/utils/permalinks';

const metadata = {
  title: 'Seguir Noticiencias por RSS',
  description:
    'Sigue las publicaciones de Noticiencias con el canal RSS o consulta su archivo. Las suscripciones por correo están deshabilitadas.',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:py-14">
    <h1 class="text-balance font-heading text-4xl font-bold leading-tight text-text-body">
      RSS y archivo de Noticiencias
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-text-muted">
      Las suscripciones por correo están deshabilitadas. Puedes seguir las publicaciones con un
      lector RSS, sin entregar tu correo, o consultar el archivo.
    </p>
    <nav aria-label="Opciones de lectura" class="mt-6 flex flex-wrap gap-4">
      <a
        href={getAsset('/rss.xml')}
        class="inline-flex min-h-11 items-center rounded-md border border-border-subtle px-4 py-2 font-semibold text-primary hover:underline underline-offset-4"
        >Abrir canal RSS</a
      >
      <a
        href="/blog/"
        class="inline-flex min-h-11 items-center rounded-md border border-border-subtle px-4 py-2 font-semibold text-primary hover:underline underline-offset-4"
        >Explorar el archivo</a
      >
    </nav>
    <p class="mt-6 text-sm leading-relaxed text-text-muted">
      Copia la dirección del canal RSS en tu lector habitual. Puedes dejar de seguirlo eliminándolo
      de ese lector.
    </p>
  </section>
</Layout>

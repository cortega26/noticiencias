---
import Layout from '~/layouts/BaseLayout.astro';
import { fetchPosts } from '~/utils/blog';
import { buildSeriesDossiers } from '~/utils/series';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/date';

const posts = await fetchPosts();
const seriesList = buildSeriesDossiers(posts);

const metadata = {
  title: 'Series de investigación',
  description:
    'Colecciones editoriales para leer una historia científica o tecnológica con continuidad: descripción, número de artículos y por dónde empezar.',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
    <header class="mb-8 border-b border-border-subtle pb-5">
      <h1 class="font-heading text-4xl font-black leading-tight text-text-body md:text-5xl">
        Series de investigación
      </h1>
      <p class="mt-3 max-w-3xl text-lg leading-relaxed text-text-muted">
        Lecturas agrupadas para leer una historia científica o tecnológica con más continuidad.
      </p>
    </header>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        seriesList.length === 0 ? (
          <p class="text-center text-gray-500 col-span-full">
            Próximamente: Nuevas series en desarrollo.
          </p>
        ) : (
          seriesList.map((dossier) => (
            <a
              href={getPermalink(`/series/${dossier.slug}`, 'page')}
              class="flex flex-col border border-border-subtle p-5 hover:border-primary"
            >
              <h2 class="font-heading text-xl font-bold text-text-body">{dossier.name}</h2>
              <p class="mt-2 flex-grow text-sm leading-relaxed text-text-muted">
                {dossier.description}
              </p>
              <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-text-muted">
                {`${dossier.count} ${dossier.count === 1 ? 'artículo' : 'artículos'}`} · Actualizada
                el {getFormattedDate(dossier.latestDate, 'long')}
              </p>
              <span class="mt-3 text-sm font-semibold text-primary">Ver la serie →</span>
            </a>
          ))
        )
      }
    </div>
  </section>
</Layout>

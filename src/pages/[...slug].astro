---
import { getPermalink } from '~/utils/permalinks';
import { fetchPosts } from '~/utils/blog';
import { rankAllRelatedPosts, type RelatedSelection } from '~/utils/related';
import PostLayout from '~/layouts/PostLayout.astro';
import type { Post } from '~/types';

export async function getStaticPaths() {
  const posts = await fetchPosts();
  const relatedById = rankAllRelatedPosts(posts, 4);
  return posts.map((post) => ({
    params: { slug: post.permalink?.replace(/^\/|\/$/g, '') },
    props: { post, related: relatedById.get(post.id) },
  }));
}

interface Props {
  post: Post;
  related?: RelatedSelection;
}

const { post, related } = Astro.props;
const url = post.permalink || getPermalink(post.slug, 'post');
---

<PostLayout post={post} url={url} related={related}>
  {post.Content ? <post.Content /> : <Fragment set:html={post.content} />}
</PostLayout>

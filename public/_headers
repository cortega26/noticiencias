# GitHub Pages does not process _headers files — these are NOT applied in production.
# Keep this file in sync with docs/DEPLOYMENT_SECURITY_HEADERS.md and the live edge policy.
# CSP is currently duplicated in CommonMeta.astro because GitHub Pages cannot emit it itself.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), accelerometer=(), gyroscope=(), magnetometer=(), usb=(), interest-cohort=()
  # Content-Security-Policy: CSP is set via <meta> tag in CommonMeta.astro for GitHub Pages compatibility.
  # Uncomment below and remove the meta tag if deploying to Netlify/Cloudflare Pages.
  # The directives below are kept byte-identical to the meta tag in
  # CommonMeta.astro; tests/compliance.test.ts fails the build if they drift.
  # Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.cdn.noticiencias.com; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://cloudflareinsights.com https://buttondown.com; object-src 'none'; base-uri 'self'; form-action 'self' https://buttondown.com;
